#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depth_texture;
layout(rg32f, set = 0, binding = 1) uniform writeonly image2D depth_range_output;
layout(set = 0, binding = 2, std140) uniform SSRParams {
	mat4 inverse_projection;
	mat4 projection;
	vec4 resolution;
} params;

// SSR_GEOMETRY_INCLUDE

const float SSR_HIZ_EMPTY_MIN = 3.402823466e+38;
const float SSR_HIZ_UNBOUNDED_MAX = 3.402823466e+38;

bool ssr_hiz_read_view_position(ivec2 pixel, ivec2 full_size,
		out vec3 view_position) {
	view_position = vec3(0.0);
	if (any(lessThan(pixel, ivec2(0))) || any(greaterThanEqual(pixel, full_size))) {
		return false;
	}
	float raw_depth = texelFetch(depth_texture, pixel, 0).r;
	vec2 uv = (vec2(pixel) + 0.5) / vec2(full_size);
	return ssr_geometry_reconstruct_view_position(params.inverse_projection,
			uv, raw_depth, view_position);
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 full_size = imageSize(depth_range_output);
	if (any(greaterThanEqual(pixel, full_size))) {
		return;
	}
	vec2 range = vec2(SSR_HIZ_EMPTY_MIN, 0.0);
	vec3 center_position;
	if (ssr_hiz_read_view_position(pixel, full_size, center_position)) {
		vec3 x_negative;
		vec3 x_positive;
		vec3 y_negative;
		vec3 y_positive;
		bool x_negative_valid = ssr_hiz_read_view_position(pixel - ivec2(1, 0),
				full_size, x_negative);
		bool x_positive_valid = ssr_hiz_read_view_position(pixel + ivec2(1, 0),
				full_size, x_positive);
		bool y_negative_valid = ssr_hiz_read_view_position(pixel - ivec2(0, 1),
				full_size, y_negative);
		bool y_positive_valid = ssr_hiz_read_view_position(pixel + ivec2(0, 1),
				full_size, y_positive);
		vec3 geometric_normal;
		float center_depth = -center_position.z;
		if (ssr_geometry_fit_local_plane(center_position,
				x_negative, x_negative_valid, x_positive, x_positive_valid,
				y_negative, y_negative_valid, y_positive, y_positive_valid,
				geometric_normal)) {
			if (!ssr_geometry_plane_pixel_depth_envelope(params.inverse_projection,
					pixel, full_size, center_position, geometric_normal,
					center_depth, range)) {
				range = vec2(0.0, SSR_HIZ_UNBOUNDED_MAX);
			}
		}
	}
	imageStore(depth_range_output, pixel, vec4(range, 0.0, 0.0));
}
