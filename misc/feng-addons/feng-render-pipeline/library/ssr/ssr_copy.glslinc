#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D scene_color;
layout(set = 0, binding = 1) uniform sampler2D specular_color;
layout(rgba16f, set = 0, binding = 2) uniform writeonly image2D color_copy;
layout(set = 0, binding = 3, std140) uniform SSRParams {
	mat4 inverse_projection;
	mat4 projection;
	vec4 resolution; // full width/height and previous-minus-current TAA jitter delta.
	vec4 trace; // maximum view distance, thickness, origin bias, roughness cutoff.
	vec4 temporal; // history weight, exposure ratio, history valid, motion available.
	vec4 options; // step count, frame index, intensity, separate-specular flag.
	mat4 view_to_world;
	mat4 previous_world_to_view;
	mat4 previous_projection;
} params;

bool finite_vec3(vec3 value) {
	return !any(isnan(value)) && !any(isinf(value));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(color_copy);
	if (any(greaterThanEqual(pixel, size))) {
		return;
	}
	vec4 color = texelFetch(scene_color, pixel, 0);
	vec3 result = finite_vec3(color.rgb) ? color.rgb : vec3(0.0);
	if (params.options.w > 0.5) {
		vec3 separate_specular = texelFetch(specular_color, pixel, 0).rgb;
		if (finite_vec3(separate_specular)) {
			result += separate_specular;
		}
	}
	imageStore(color_copy, pixel, vec4(clamp(result, vec3(0.0), vec3(65504.0)), 1.0));
}
