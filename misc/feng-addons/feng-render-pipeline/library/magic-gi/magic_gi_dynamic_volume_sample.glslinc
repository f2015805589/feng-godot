#ifndef FRP_MAGIC_GI_DYNAMIC_VOLUME_SAMPLE_GLSLINC
#define FRP_MAGIC_GI_DYNAMIC_VOLUME_SAMPLE_GLSLINC

#ifndef MAGIC_GI_SH4_TENSOR_GLSLINC
#include "magic_gi_sh4_tensor.glslinc"
#endif

// Independent live TransferMatrix volume path. This specialization intentionally
// does not include the layout-9 surface-chart sampler or its per-pixel BVH path.
// Native lighting resolves this to Godot's scene sampler. The after-GBuffer
// compute wrapper defines it to its explicit set-1 linear sampler. Keeping the
// sampling implementation here makes both paths use the same moment/SH math.
#ifndef FRP_MAGIC_GI_DYNAMIC_VOLUME_LINEAR_SAMPLER
#define FRP_MAGIC_GI_DYNAMIC_VOLUME_LINEAR_SAMPLER SAMPLER_LINEAR_CLAMP
#endif

layout(set = 1, binding = 69) uniform texture3D frp_magic_gi_dynamic_volume_response0;
layout(set = 1, binding = 76, std140) uniform FRPMagicGIDynamicVolumeParameters0 {
	vec4 lod_origin_spacing[4]; // logical cell-center origin and spacing per LOD.
	ivec4 dimensions_version; // physical atlas dimensions xyz, layout version.
	ivec4 angular_layout; // response resolution, tile size, LOD count, logical resolution.
#ifdef MAGIC_GI_PREPARED_PAGED_ONLY
	vec4 extended_lod_origin_spacing[6];
	vec4 camera_radius;
#endif
} frp_magic_gi_dynamic_volume0;
layout(set = 1, binding = 77, std140) uniform FRPMagicGIDynamicVolumeOwner0 {
	mat4 world_to_local;
	vec4 owner_size_enabled;
	vec4 control; // strength, replace native Sky, scene normalization, QA mode.
} frp_magic_gi_dynamic_owner0;
// Per-cell 10x10 RG32F octahedral moment tile: the 8x8 source grid plus
// folded gutters, so hardware bilinear filtering is equivalent to the old 4 taps.
layout(set = 1, binding = 87) uniform texture3D frp_magic_gi_dynamic_volume_moment_atlas;
layout(set = 1, binding = 88, std430) readonly buffer FRPMagicGIDynamicVolumeRelocation {
	vec4 values[];
} frp_magic_gi_dynamic_relocation;
layout(set = 1, binding = 89, std430) readonly buffer FRPMagicGIDynamicVolumeValidity {
	uint values[];
} frp_magic_gi_dynamic_validity;

#ifdef USE_MULTIVIEW
layout(set = 1, binding = 78) uniform texture3D frp_magic_gi_dynamic_volume_response1;
layout(set = 1, binding = 85, std140) uniform FRPMagicGIDynamicVolumeParameters1 {
	vec4 lod_origin_spacing[4];
	ivec4 dimensions_version;
	ivec4 angular_layout;
#ifdef MAGIC_GI_PREPARED_PAGED_ONLY
	vec4 extended_lod_origin_spacing[6];
	vec4 camera_radius;
#endif
} frp_magic_gi_dynamic_volume1;
layout(set = 1, binding = 86, std140) uniform FRPMagicGIDynamicVolumeOwner1 {
	mat4 world_to_local;
	vec4 owner_size_enabled;
	vec4 control;
} frp_magic_gi_dynamic_owner1;
#endif

vec4 frp_magic_gi_dynamic_volume_origin_spacing(int view, int lod) {
#ifdef MAGIC_GI_PREPARED_PAGED_ONLY
	if (lod >= 4) {
#ifdef USE_MULTIVIEW
		if (view == 1) { return frp_magic_gi_dynamic_volume1.extended_lod_origin_spacing[lod - 4]; }
#endif
		return frp_magic_gi_dynamic_volume0.extended_lod_origin_spacing[lod - 4];
	}
#endif
#ifdef USE_MULTIVIEW
	if (view == 1) { return frp_magic_gi_dynamic_volume1.lod_origin_spacing[lod]; }
#endif
	return frp_magic_gi_dynamic_volume0.lod_origin_spacing[lod];
}

ivec4 frp_magic_gi_dynamic_volume_dimensions_version(int view) {
#ifdef USE_MULTIVIEW
	if (view == 1) { return frp_magic_gi_dynamic_volume1.dimensions_version; }
#endif
	return frp_magic_gi_dynamic_volume0.dimensions_version;
}

ivec4 frp_magic_gi_dynamic_volume_angular_layout(int view) {
#ifdef USE_MULTIVIEW
	if (view == 1) { return frp_magic_gi_dynamic_volume1.angular_layout; }
#endif
	return frp_magic_gi_dynamic_volume0.angular_layout;
}

#ifdef MAGIC_GI_PREPARED_PAGED_ONLY
vec4 frp_magic_gi_paged_camera_radius(int view) {
#ifdef USE_MULTIVIEW
	if (view == 1) { return frp_magic_gi_dynamic_volume1.camera_radius; }
#endif
	return frp_magic_gi_dynamic_volume0.camera_radius;
}
#endif

mat4 frp_magic_gi_dynamic_volume_world_to_local(int view) {
#ifdef USE_MULTIVIEW
	if (view == 1) { return frp_magic_gi_dynamic_owner1.world_to_local; }
#endif
	return frp_magic_gi_dynamic_owner0.world_to_local;
}

vec4 frp_magic_gi_dynamic_volume_owner_size(int view) {
#ifdef USE_MULTIVIEW
	if (view == 1) { return frp_magic_gi_dynamic_owner1.owner_size_enabled; }
#endif
	return frp_magic_gi_dynamic_owner0.owner_size_enabled;
}

vec4 frp_magic_gi_dynamic_volume_owner_control(int view) {
#ifdef USE_MULTIVIEW
	if (view == 1) { return frp_magic_gi_dynamic_owner1.control; }
#endif
	return frp_magic_gi_dynamic_owner0.control;
}

bool frp_magic_gi_dynamic_volume_owner_contains(vec3 world, int view) {
	vec4 size_enabled = frp_magic_gi_dynamic_volume_owner_size(view);
	if (size_enabled.w <= 0.5) { return false; }
	vec3 local_position = (frp_magic_gi_dynamic_volume_world_to_local(view) *
			vec4(world, 1.0)).xyz;
	return magic_gi_sh4_finite_vec3(local_position) &&
			all(lessThanEqual(abs(local_position), size_enabled.xyz * 0.5));
}

ivec3 frp_magic_gi_dynamic_volume_clamp_cell(ivec3 cell, ivec3 dimensions) {
	return clamp(cell, ivec3(0), dimensions - ivec3(1));
}

uint frp_magic_gi_dynamic_volume_cell_index(ivec3 cell, ivec3 dimensions) {
	return uint((cell.z * dimensions.y + cell.y) * dimensions.x + cell.x);
}

vec2 frp_magic_gi_dynamic_volume_octa_encode(vec3 direction) {
	vec3 n = normalize(direction);
	float denominator = abs(n.x) + abs(n.y) + abs(n.z);
	if (!(denominator > 1e-8)) { return vec2(0.5); }
	vec2 p = n.xy / denominator;
	if (n.z < 0.0) {
		p = vec2((1.0 - abs(p.y)) * (p.x < 0.0 ? -1.0 : 1.0),
				(1.0 - abs(p.x)) * (p.y < 0.0 ? -1.0 : 1.0));
	}
	return p * 0.5 + 0.5;
}

vec4 frp_magic_gi_dynamic_volume_fetch_response(ivec3 cell, vec3 normal_world,
		ivec3 dimensions, ivec4 angular_layout, int view) {
	int resolution = angular_layout.x;
	int tile_size = angular_layout.y;
	if ((resolution != 8 && resolution != 12 && resolution != 16) ||
			tile_size != resolution + 2) {
		return vec4(0.0);
	}
	vec2 octahedral = frp_magic_gi_dynamic_volume_octa_encode(normal_world);
	vec2 atlas_xy = (vec2(cell.xy * tile_size + ivec2(1)) +
			octahedral * float(resolution)) /
			vec2(dimensions.xy * tile_size);
	vec3 atlas_uv = vec3(atlas_xy, (float(cell.z) + 0.5) / float(dimensions.z));
#ifdef USE_MULTIVIEW
	if (view == 1) {
		return texture(sampler3D(frp_magic_gi_dynamic_volume_response1,
				FRP_MAGIC_GI_DYNAMIC_VOLUME_LINEAR_SAMPLER), atlas_uv);
	}
#endif
	return texture(sampler3D(frp_magic_gi_dynamic_volume_response0,
			FRP_MAGIC_GI_DYNAMIC_VOLUME_LINEAR_SAMPLER), atlas_uv);
}

vec2 frp_magic_gi_dynamic_volume_sample_moments(ivec3 cell,
		ivec3 dimensions, vec3 direction) {
	vec2 octahedral = frp_magic_gi_dynamic_volume_octa_encode(direction);
	vec2 atlas_xy = (vec2(cell.xy * 10 + ivec2(1)) + octahedral * 8.0) /
			vec2(dimensions.xy * 10);
	vec3 atlas_uv = vec3(atlas_xy, (float(cell.z) + 0.5) / float(dimensions.z));
	return texture(sampler3D(frp_magic_gi_dynamic_volume_moment_atlas,
			FRP_MAGIC_GI_DYNAMIC_VOLUME_LINEAR_SAMPLER), atlas_uv).rg;
}

float frp_magic_gi_dynamic_volume_cell_visibility(ivec3 cell,
		ivec3 dimensions, vec3 source_position, vec3 world) {
	vec3 ray = world - source_position;
	float distance_to_receiver = length(ray);
	if (!(distance_to_receiver > 1e-5)) { return 1.0; }
	vec2 moments = frp_magic_gi_dynamic_volume_sample_moments(cell,
			dimensions, ray);
	if (any(isnan(moments)) || any(isinf(moments)) || moments.x < 0.0 || moments.y < 0.0) {
		return 0.0;
	}
	float variance = max(moments.y - moments.x * moments.x, 1e-5);
	float delta = max(distance_to_receiver - moments.x, 0.0);
	float visible = delta <= 0.0 ? 1.0 : variance / (variance + delta * delta);
	return clamp(visible, 0.0, 1.0);
}

vec3 frp_magic_gi_dynamic_volume_correct_grid_for_relocation(vec3 grid_position,
		int logical_resolution, int lod, int view) {
	ivec3 base = ivec3(floor(grid_position));
	vec3 fraction = fract(grid_position);
	vec3 offset_sum = vec3(0.0);
	float valid_weight = 0.0;
	int cells_per_lod = logical_resolution * logical_resolution * logical_resolution;
	for (int z = 0; z < 2; z++) for (int y = 0; y < 2; y++)
	for (int x = 0; x < 2; x++) {
		float weight = (x == 1 ? fraction.x : 1.0 - fraction.x)
				* (y == 1 ? fraction.y : 1.0 - fraction.y)
				* (z == 1 ? fraction.z : 1.0 - fraction.z);
		ivec3 cell = clamp(base + ivec3(x, y, z), ivec3(0),
				ivec3(logical_resolution - 1));
		uint cell_index = uint(lod * cells_per_lod +
				(cell.z * logical_resolution + cell.y) * logical_resolution + cell.x);
		if (frp_magic_gi_dynamic_validity.values[cell_index] == 0u) { continue; }
		offset_sum += frp_magic_gi_dynamic_relocation.values[cell_index].xyz * weight;
		valid_weight += weight;
	}
	vec3 correction = valid_weight > 1e-6 ? offset_sum / valid_weight : vec3(0.0);
	return grid_position - correction /
			frp_magic_gi_dynamic_volume_origin_spacing(view, lod).w;
}

bool frp_magic_gi_dynamic_volume_sample_lod(vec3 world,
		vec3 geometric_normal_world, vec3 shading_normal_world,
		int view, int lod, out vec3 incident, out float coverage,
		out float front_support) {
	incident = vec3(0.0);
	coverage = 0.0;
	front_support = 0.0;
	vec4 origin_spacing = frp_magic_gi_dynamic_volume_origin_spacing(view, lod);
	ivec4 dimensions_version = frp_magic_gi_dynamic_volume_dimensions_version(view);
	ivec4 angular_layout = frp_magic_gi_dynamic_volume_angular_layout(view);
	int logical_resolution = angular_layout.w;
	if (dimensions_version.w != 4 || logical_resolution <= 0 ||
			angular_layout.z < 3 || angular_layout.z > 4 ||
			dimensions_version.x != logical_resolution ||
			dimensions_version.y != logical_resolution ||
			dimensions_version.z != logical_resolution * angular_layout.z ||
			!(origin_spacing.w > 0.0) || !magic_gi_sh4_finite_vec3(world) ||
			!magic_gi_sh4_finite_vec3(geometric_normal_world) ||
			!magic_gi_sh4_finite_vec3(shading_normal_world) ||
			!frp_magic_gi_dynamic_volume_owner_contains(world, view)) {
		return false;
	}
	vec3 geometric_normal = normalize(geometric_normal_world);
	vec3 shading_normal = normalize(shading_normal_world);
	if (!magic_gi_sh4_finite_vec3(geometric_normal) ||
			dot(geometric_normal, geometric_normal) < 0.99 ||
			!magic_gi_sh4_finite_vec3(shading_normal) ||
			dot(shading_normal, shading_normal) < 0.99) { return false; }
	vec3 unwarped_grid = (world - origin_spacing.xyz) / origin_spacing.w;
	if (any(lessThan(unwarped_grid, vec3(-0.5))) ||
			any(greaterThan(unwarped_grid, vec3(float(logical_resolution) - 0.5)))) {
		return false;
	}
	vec3 grid_position = frp_magic_gi_dynamic_volume_correct_grid_for_relocation(
			unwarped_grid, logical_resolution, lod, view);
	ivec3 base = ivec3(floor(grid_position));
	vec3 fraction = fract(grid_position);
	vec3 weighted_incident = vec3(0.0);
	float valid_weight = 0.0;
	float front_side_weight = 0.0;
	float visible_weight = 0.0;
	// Runner-only modes 6/7/8/9 isolate receiver moments and sidedness. Mode 7
	// bypasses only the receiver hemisphere gate with moments forced visible;
	// mode 8 keeps the hard predicate with moments visible; mode 9 bypasses
	// sidedness while retaining actual moment visibility. Production uses the
	// same hard geometric support predicate as mode 8.
	float qa_mode = frp_magic_gi_dynamic_volume_owner_control(view).w;
	bool qa_force_visible = abs(qa_mode - 6.0) < 0.01 ||
			abs(qa_mode - 7.0) < 0.01 || abs(qa_mode - 8.0) < 0.01;
	bool qa_bypass_hemisphere = abs(qa_mode - 7.0) < 0.01 ||
			abs(qa_mode - 9.0) < 0.01;
	int cells_per_lod = logical_resolution * logical_resolution * logical_resolution;
	for (int z = 0; z < 2; z++) for (int y = 0; y < 2; y++)
	for (int x = 0; x < 2; x++) {
		float weight = (x == 1 ? fraction.x : 1.0 - fraction.x)
				* (y == 1 ? fraction.y : 1.0 - fraction.y)
				* (z == 1 ? fraction.z : 1.0 - fraction.z);
		if (!(weight > 0.0)) { continue; }
		ivec3 local_cell = clamp(base + ivec3(x, y, z), ivec3(0),
				ivec3(logical_resolution - 1));
		ivec3 cell = ivec3(local_cell.xy, lod * logical_resolution + local_cell.z);
		uint cell_index = uint(lod * cells_per_lod +
				(local_cell.z * logical_resolution + local_cell.y) * logical_resolution +
				local_cell.x);
		if (frp_magic_gi_dynamic_validity.values[cell_index] == 0u) { continue; }
		vec3 source_position = origin_spacing.xyz + vec3(local_cell) * origin_spacing.w
				+ frp_magic_gi_dynamic_relocation.values[cell_index].xyz;
		vec4 response = frp_magic_gi_dynamic_volume_fetch_response(cell, shading_normal,
				dimensions_version.xyz, angular_layout, view);
		if (!magic_gi_sh4_finite_vec4(response) || response.a < 0.5) {
			continue;
		}
		// Spatial support is independent of the receiver's oriented hemisphere
		// and of ray visibility. It controls LOD selection and sky replacement.
		valid_weight += weight;
		// A free-space probe on the far side of the receiver surface cannot
		// contribute to its incident hemisphere. Moment visibility alone is too
		// coarse to guarantee this: a wide angular bin can report V=1 even when
		// the source-to-receiver segment crosses the receiver's own slab. Use the
		// geometric receiver normal for this sidedness test; keep shading normals
		// (including normal maps) exclusively for the response lookup above.
		float receiver_side = dot(geometric_normal, source_position - world);
		if (!qa_bypass_hemisphere && receiver_side <= max(origin_spacing.w * 1e-4, 1e-5)) {
			continue;
		}
		front_side_weight += weight;
		float visibility = qa_force_visible ? 1.0 :
				frp_magic_gi_dynamic_volume_cell_visibility(cell,
					dimensions_version.xyz, source_position, world);
		if (!(visibility > 1e-8)) { continue; }
		float sample_weight = weight * visibility;
		weighted_incident += response.rgb * sample_weight;
		visible_weight += sample_weight;
	}
	if (!(valid_weight > 1e-6) || !(front_side_weight > 1e-6)) { return false; }
	if (visible_weight > 1e-6) {
		incident = weighted_incident / visible_weight;
	}
	coverage = clamp(valid_weight, 0.0, 1.0);
	front_support = clamp(front_side_weight, 0.0, 1.0);
	return coverage > 1e-6 && magic_gi_sh4_finite_vec3(incident);
}

#ifdef MAGIC_GI_OLV_GATE
// OLV categorical indoor/outdoor gate, applied before SH interpolation.
// Prepared-volume variants bind a generation-validated label atlas and its
// layout metadata; the add-on publishes labels with the corresponding prepared
// transfer generation. Every declaration stays behind MAGIC_GI_OLV_GATE, so
// variants without the OLV selector keep the previous source path and bindings.
//
// Label payload ABI
// -----------------
// Each R8 texel stores only its categorical class: 0 unavailable, 1 exterior,
// 2 interior. Lighting is held in two independent X-adjacent SH atlases, each
// extended by one texel at domain boundaries before hardware interpolation.
// The label window has a halo independent of the smaller SH response window.
// label_meta.w records its side; label_meta.z records the total layer depth.
// label_meta.z is only the payload's DECLARED depth, never a measurement: the
// uploader must keep it equal to the allocated label atlas depth, because an
// out-of-range texel fetch has no clamp-to-edge fallback. The gate refuses any
// payload whose declared depth is too small, and the fixture asserts that the
// declared depth equals the allocated depth it actually binds.
// The payload is keyed to the response atlas it describes: a stale or foreign
// payload abstains instead of deleting transfer.
const int MAGIC_GI_OLV_LABEL_UNSET = 0;
const int MAGIC_GI_OLV_LABEL_EXTERIOR = 1;
const int MAGIC_GI_OLV_LABEL_INTERIOR = 2;
const int MAGIC_GI_OLV_LABEL_SCHEMA = 1;
// An accepted corner weight at or below this is no support at all. Such a
// sample reports a miss rather than a black "hit", because a hit also takes
// sky ownership in frp_magic_gi_dynamic_volume_apply.
const float MAGIC_GI_OLV_MIN_ACCEPTED = 1e-6;

// Categorical labels use exact texel fetches; each partition's SH volume uses
// hardware trilinear filtering. Filtering labels would invent unlabelled domains.
#ifndef FRP_MAGIC_GI_OLV_LABEL_SAMPLER
#define FRP_MAGIC_GI_OLV_LABEL_SAMPLER SAMPLER_NEAREST_CLAMP
#endif

layout(set = 1, binding = 90) uniform texture3D frp_magic_gi_olv_label_atlas;
layout(set = 1, binding = 91, std140) uniform FRPMagicGIDynamicVolumeOLVLabels0 {
	// Physical atlas dimensions and layout version of the response volume this
	// payload was compiled for. All four lanes must match.
	ivec4 label_dimensions_version;
	// x: label schema, y: payload enabled, z: label atlas depth, w: label side.
	ivec4 label_meta;
} frp_magic_gi_olv_labels0;

bool frp_magic_gi_olv_label_trusted(int label) {
	return label == MAGIC_GI_OLV_LABEL_EXTERIOR ||
			label == MAGIC_GI_OLV_LABEL_INTERIOR;
}

// Payload guards, split into three independently probeable predicates so a
// missing conjunct cannot hide behind another one.
bool frp_magic_gi_olv_payload_schema_ok() {
	return (frp_magic_gi_olv_labels0.label_meta.x == MAGIC_GI_OLV_LABEL_SCHEMA ||
			frp_magic_gi_olv_labels0.label_meta.x == 2) &&
			frp_magic_gi_olv_labels0.label_meta.y == 1;
}

// The payload must describe the exact response atlas it was compiled for,
// including the layout version lane, or its labels cannot be trusted.
bool frp_magic_gi_olv_payload_identity_ok(ivec4 dimensions) {
	return all(equal(frp_magic_gi_olv_labels0.label_dimensions_version, dimensions));
}

// Both atlases must be deep enough for every (lod, cell) the gate addresses.
bool frp_magic_gi_olv_payload_depth_ok(ivec4 dimensions, ivec4 layout_info) {
	if (layout_info.w <= 0 || layout_info.z <= 0) { return false; }
	if (layout_info.w > dimensions.x || layout_info.w > dimensions.y) { return false; }
	if (dimensions.z < layout_info.w * layout_info.z) { return false; }
	int side = max(layout_info.w, frp_magic_gi_olv_labels0.label_meta.w);
	return frp_magic_gi_olv_labels0.label_meta.z >= side * layout_info.z;
}

bool frp_magic_gi_olv_payload_matches(ivec4 dimensions, ivec4 layout_info) {
	return frp_magic_gi_olv_payload_schema_ok() &&
			frp_magic_gi_olv_payload_identity_ok(dimensions) &&
			frp_magic_gi_olv_payload_depth_ok(dimensions, layout_info);
}

// Fetch one labelled cell by exact texel coordinate. Out-of-range cells clamp
// exactly like the response taps, and the declared depth bounds the layer.
int frp_magic_gi_olv_label_fetch_raw(ivec3 cell, int lod, int resolution,
		ivec4 dimensions) {
	int side = max(resolution, frp_magic_gi_olv_labels0.label_meta.w);
	int halo = (side - resolution) / 2;
	ivec3 clamped = clamp(cell + ivec3(halo), ivec3(0), ivec3(side - 1));
	int z_index = lod * side + clamped.z;
	if (z_index < 0 || z_index >= frp_magic_gi_olv_labels0.label_meta.z) {
		return MAGIC_GI_OLV_LABEL_UNSET;
	}
	float value = texelFetch(sampler3D(frp_magic_gi_olv_label_atlas,
			FRP_MAGIC_GI_OLV_LABEL_SAMPLER), ivec3(clamped.xy, z_index), 0).r;
	// The bound atlas is R8_UNORM: texels are finite and nonnegative.
	return int(value * 255.0 + 0.5);
}

int frp_magic_gi_olv_label_fetch(ivec3 cell, int lod, int resolution, ivec4 dimensions) {
	int value = frp_magic_gi_olv_label_fetch_raw(cell, lod, resolution, dimensions);
	return frp_magic_gi_olv_labels0.label_meta.x == 2 ? (value & 3) : value;
}

int frp_magic_gi_olv_receiver_label_fetch(ivec3 cell, int lod, int resolution, ivec4 dimensions) {
	int value = frp_magic_gi_olv_label_fetch_raw(cell, lod, resolution, dimensions);
	return frp_magic_gi_olv_labels0.label_meta.x == 2 ? ((value >> 2) & 3) : value;
}

// A surface owns the free space on its geometric-normal side. Looking up
// the unshifted closest grid point can select a probe across a thin wall.
ivec3 frp_magic_gi_olv_receiver_cell(vec3 grid, vec3 geometric_normal, int resolution) {
	vec3 bias = dot(geometric_normal, geometric_normal) > 1e-8 ? normalize(geometric_normal) * 0.5 : vec3(0.0);
	return clamp(ivec3(floor(grid + bias + vec3(0.5))), ivec3(0), ivec3(resolution - 1));
}

// A receiver has one categorical domain, independent of the lighting LOD.
// The label halo retains fine source labels even outside the SH window.
// The caller validates the shared payload once before entering the LOD loop.
int frp_magic_gi_olv_receiver_label_world(vec3 world, vec3 geometric_normal, int view, int lod) {
	if (view != 0) { return MAGIC_GI_OLV_LABEL_UNSET; }
	vec4 origin = frp_magic_gi_dynamic_volume_origin_spacing(view, lod);
	ivec4 dimensions = frp_magic_gi_dynamic_volume_dimensions_version(view);
	ivec4 layout_info = frp_magic_gi_dynamic_volume_angular_layout(view);
	if (!(origin.w > 0.0) || lod < 0 || lod >= layout_info.z) {
		return MAGIC_GI_OLV_LABEL_UNSET;
	}
	int side = max(layout_info.w, frp_magic_gi_olv_labels0.label_meta.w);
	int halo = (side - layout_info.w) / 2;
	vec3 grid = (world - origin.xyz) / origin.w;
	vec3 label_grid = grid + vec3(halo);
	if (!magic_gi_sh4_finite_vec3(grid)
			|| any(lessThan(label_grid, vec3(-0.5)))
			|| any(greaterThan(label_grid, vec3(side) - vec3(0.5)))) {
		return MAGIC_GI_OLV_LABEL_UNSET;
	}
	ivec3 cell = frp_magic_gi_olv_receiver_cell(label_grid, geometric_normal, side) - ivec3(halo);
	int label = frp_magic_gi_olv_receiver_label_fetch(cell, lod, layout_info.w, dimensions);
	if (dot(vec3(cell) - grid, geometric_normal) >= -1e-4 && frp_magic_gi_olv_label_trusted(label)) {
		return label;
	}
	// An invalid grid anchor is not an outdoor label. Select one nearest
	// labelled corner on the visible side, with no vote or label interpolation.
	float nearest_distance = 1e20;
	int nearest_label = MAGIC_GI_OLV_LABEL_UNSET;
	ivec3 base = ivec3(floor(label_grid));
	for (int z = 0; z < 2; z++) for (int y = 0; y < 2; y++) for (int x = 0; x < 2; x++) {
		ivec3 candidate = clamp(base + ivec3(x,y,z), ivec3(0), ivec3(side - 1)) - ivec3(halo);
		vec3 delta = vec3(candidate) - grid;
		if (dot(delta, geometric_normal) < -1e-4) { continue; }
		int candidate_label = frp_magic_gi_olv_receiver_label_fetch(candidate, lod, layout_info.w, dimensions);
		float distance_squared = dot(delta, delta);
		if (frp_magic_gi_olv_label_trusted(candidate_label) && distance_squared < nearest_distance) {
			nearest_distance = distance_squared;
			nearest_label = candidate_label;
		}
	}
	return nearest_label;
}

int frp_magic_gi_olv_receiver_domain(vec3 world, vec3 geometric_normal, int view) {
	if (view != 0) { return MAGIC_GI_OLV_LABEL_UNSET; }
	ivec4 layout_info = frp_magic_gi_dynamic_volume_angular_layout(view);
	ivec4 dimensions = frp_magic_gi_dynamic_volume_dimensions_version(view);
	if (!frp_magic_gi_olv_payload_matches(dimensions, layout_info)) { return MAGIC_GI_OLV_LABEL_UNSET; }
	for (int lod = 0; lod < clamp(layout_info.z, 0, 10); lod++) {
		int label = frp_magic_gi_olv_receiver_label_world(world, geometric_normal, view, lod);
		if (frp_magic_gi_olv_label_trusted(label)) { return label; }
#if defined(FRP_MAGIC_GI_OLV_VISIBLE_RAY) || defined(MAGIC_GI_PREPARED_PAGED_ONLY)
		if (lod == 0 && frp_magic_gi_olv_labels0.label_meta.x == 2) {
			// Relocated source labels cannot classify their former grid points.
			// Before trying coarser cells across a contact, use the visible
			// camera ray's nearby free space. Source partitioning is unchanged.
			#ifdef FRP_MAGIC_GI_OLV_VISIBLE_RAY
			vec3 to_camera = FRP_MAGIC_GI_OLV_VISIBLE_RAY(world, view);
			#else
			vec3 to_camera = frp_magic_gi_paged_camera_radius(view).xyz - world;
			#endif
			float distance_squared = dot(to_camera, to_camera);
			if (distance_squared > 1e-8) {
				float reciprocal_distance = inversesqrt(distance_squared);
				vec3 direction = to_camera * reciprocal_distance;
				float offset = 0.25 * min(frp_magic_gi_dynamic_volume_origin_spacing(view, 0).w,
						distance_squared * reciprocal_distance);
				label = frp_magic_gi_olv_receiver_label_world(world + direction * offset, direction, view, 0);
				if (frp_magic_gi_olv_label_trusted(label)) { return label; }
			}
		}
#endif
	}
	return MAGIC_GI_OLV_LABEL_UNSET;
}

// The mapping pass admits only source operators with this partition label,
// and dilates each partition independently. A pixel selects ONE volume and
// interpolates SH normally; no categorical values or foreign-domain SH mix.
// 0 = unavailable/stale payload, 1 = sample, 2 = no matching support.
int frp_magic_gi_olv_gate_sample(vec3 grid, int view, int lod, ivec4 dimensions,
        ivec4 layout_info, vec3 normal_world, int required_domain,
        out vec3 incident, out float coverage, out int receiver_label_out) {
    incident = vec3(0.0);
    coverage = 0.0;
    receiver_label_out = MAGIC_GI_OLV_LABEL_UNSET;
    if (view != 0 || !frp_magic_gi_olv_payload_matches(dimensions, layout_info)) return 0;
    if (lod < 0 || lod >= layout_info.z || !frp_magic_gi_olv_label_trusted(required_domain)) return 2;
    receiver_label_out = required_domain;
    vec4 packed[4];
    for (int field = 0; field < 4; field++) {
        vec3 texel = grid + vec3(0.5 + float((required_domain - 1) * layout_info.w),
                0.5, float(lod * layout_info.w + field * dimensions.z) + 0.5);
        vec3 uv = texel / vec3(dimensions.x * 2, dimensions.y, dimensions.z * 4);
        packed[field] = texture(sampler3D(frp_magic_gi_dynamic_volume_response0,
                FRP_MAGIC_GI_DYNAMIC_VOLUME_LINEAR_SAMPLER), uv);
    }
    incident = magic_gi_sh4_decode_e_over_pi(packed, normal_world, coverage);
    return coverage > MAGIC_GI_OLV_MIN_ACCEPTED && magic_gi_sh4_finite_vec3(incident) ? 1 : 2;
}
#endif // MAGIC_GI_OLV_GATE

bool frp_magic_gi_preinterpolated_sample_lod(vec3 world, vec3 normal_world, int receiver_domain,
		int view, int lod, out vec3 incident, out float coverage, out float edge_distance,
		out int olv_domain) {
	vec4 origin = frp_magic_gi_dynamic_volume_origin_spacing(view, lod);
	ivec4 dimensions = frp_magic_gi_dynamic_volume_dimensions_version(view);
	ivec4 layout_info = frp_magic_gi_dynamic_volume_angular_layout(view);
	incident = vec3(0.0); coverage = 0.0; edge_distance = 0.0;
	olv_domain = 0;
	bool schema_valid = dimensions.w == 7 || dimensions.w == 8;
#ifdef MAGIC_GI_PREPARED_PAGED_ONLY
	schema_valid = dimensions.w == 7;
#elif defined(MAGIC_GI_PREPARED_SH2_ONLY)
	schema_valid = dimensions.w == 8;
#endif
	if (!(origin.w > 0.0) || layout_info.y != 4 || !schema_valid) return false;
	vec3 grid = (world - origin.xyz) / origin.w;
	float last = float(layout_info.w - 1);
	vec3 lower = vec3(0.0);
	vec3 upper = vec3(last);
	if (lod + 1 < layout_info.z) {
		magic_gi_clv_blend_bounds(origin, frp_magic_gi_dynamic_volume_origin_spacing(view, lod + 1),
				layout_info.w, lower, upper);
	}
	if (any(lessThan(grid, lower)) || any(greaterThan(grid, upper))) return false;
	vec3 edges = min(grid - lower, upper - grid);
	edge_distance = min(edges.x, min(edges.y, edges.z));
	// Clamp inside this LOD before adding the packed field/LOD Z offsets.
	grid = clamp(grid, vec3(0.0), vec3(last));
#ifdef MAGIC_GI_OLV_GATE
	{
		// Select one partition before hardware filtering. A missing payload
		// retains the unpartitioned path used when OLV is disabled.
		int olv_result = frp_magic_gi_olv_gate_sample(grid, view, lod, dimensions,
				layout_info, normal_world, receiver_domain, incident, coverage, olv_domain);
		if (olv_result == 2) {
			incident = vec3(0.0);
			coverage = 0.0;
			olv_domain = 0;
			return false;
		}
		if (olv_result == 1) {
			float olv_decode_scale = intBitsToFloat(layout_info.x);
			incident *= olv_decode_scale > 0.0 ? olv_decode_scale : 1.0;
			// The gate normalized the surviving support already. Discarding it
			// below 50% creates black wall bands exactly where OLV rejects leaks.
			return coverage > MAGIC_GI_OLV_MIN_ACCEPTED && magic_gi_sh4_finite_vec3(incident);
		}
		olv_domain = 0;
	}
#endif
	vec4 packed[4];
	for (int field = 0; field < 4; field++) {
		vec3 uv = (grid + vec3(0.5, 0.5,
			float(lod * layout_info.w + field * dimensions.z) + 0.5)) /
			vec3(dimensions.xy, dimensions.z * 4);
#ifdef USE_MULTIVIEW
		if (view == 1) {
			packed[field] = texture(sampler3D(frp_magic_gi_dynamic_volume_response1,
				FRP_MAGIC_GI_DYNAMIC_VOLUME_LINEAR_SAMPLER), uv);
		} else
#endif
		{
			packed[field] = texture(sampler3D(frp_magic_gi_dynamic_volume_response0,
				FRP_MAGIC_GI_DYNAMIC_VOLUME_LINEAR_SAMPLER), uv);
		}
	}
	incident = magic_gi_sh4_decode_e_over_pi(packed, normal_world, coverage);
	float decode_scale = intBitsToFloat(layout_info.x);
	incident *= decode_scale > 0.0 ? decode_scale : 1.0;
	return coverage > 0.5 && magic_gi_sh4_finite_vec3(incident);
}

// Diagnostics and older call sites have one normal; native PBR supplies both.
bool frp_magic_gi_preinterpolated_sample_lod(vec3 world, vec3 normal_world,
		int view, int lod, out vec3 incident, out float coverage, out float edge_distance,
		out int olv_domain) {
	int receiver_domain = 0;
#ifdef MAGIC_GI_OLV_GATE
	receiver_domain = frp_magic_gi_olv_receiver_domain(world, normal_world, view);
#endif
	return frp_magic_gi_preinterpolated_sample_lod(world, normal_world, receiver_domain,
		view, lod, incident, coverage, edge_distance, olv_domain);
}

bool frp_magic_gi_dynamic_volume_sample(vec3 world,
		vec3 geometric_normal_world, vec3 shading_normal_world, int view,
		out vec3 incident, out float coverage) {
	incident = vec3(0.0);
	coverage = 0.0;
	ivec4 angular_layout = frp_magic_gi_dynamic_volume_angular_layout(view);
#ifdef MAGIC_GI_PREPARED_PAGED_ONLY
	int lod_count = clamp(angular_layout.z, 0, 10);
	vec4 camera_radius = frp_magic_gi_paged_camera_radius(view);
	vec3 camera_delta = world - camera_radius.xyz;
	if (!(camera_radius.w > 0.0) || dot(camera_delta, camera_delta) > camera_radius.w * camera_radius.w) return false;
#else
	int lod_count = clamp(angular_layout.z, 0, 4);
#endif
#ifdef MAGIC_GI_PREINTERPOLATED_ONLY
	{
#else
	if (frp_magic_gi_dynamic_volume_dimensions_version(view).w == 7 ||
			frp_magic_gi_dynamic_volume_dimensions_version(view).w == 8) {
#endif
		if (!frp_magic_gi_dynamic_volume_owner_contains(world, view)) return false;
		int receiver_domain = 0;
#ifdef MAGIC_GI_OLV_GATE
		receiver_domain = frp_magic_gi_olv_receiver_domain(world, geometric_normal_world, view);
#endif
		for (int lod = 0; lod < lod_count; lod++) {
			float edge;
			int fine_domain = 0;
			if (!frp_magic_gi_preinterpolated_sample_lod(world, shading_normal_world, receiver_domain,
				view, lod, incident, coverage, edge, fine_domain)) continue;
			// Adjacent levels were pre-mixed by the producer. A successful pixel
			// sample reads one LOD, including at the cascade transition.
			return true;
		}
		return false;
	}
	#ifndef MAGIC_GI_PREINTERPOLATED_ONLY
	for (int lod = 0; lod < lod_count; lod++) {
		vec3 candidate_incident;
		float candidate_coverage;
		float candidate_front_support;
		if (!frp_magic_gi_dynamic_volume_sample_lod(world, geometric_normal_world,
				shading_normal_world, view, lod, candidate_incident, candidate_coverage,
				candidate_front_support)) {
			continue;
		}
		if (candidate_coverage < 0.5) { continue; }
		// Choose the finest level with enough valid spatial support. Do not
		// blend a coarser level based on a sparse hemisphere-filtered tap mass:
		// that mass changes with surface orientation and caused visible stepping.
		incident = candidate_incident;
		coverage = candidate_coverage;
		return magic_gi_sh4_finite_vec3(incident);
	}
	return false;
	#endif
}

void frp_magic_gi_dynamic_volume_apply(vec3 world, vec3 geometric_normal_world,
		vec3 shading_normal_world, vec3 albedo, float ao, float diffuse_ao,
		int view, inout vec3 ambient_light, vec3 global_sky_light_diffuse) {
	vec4 control = frp_magic_gi_dynamic_volume_owner_control(view);
	float strength = max(control.x, 0.0);
	if (!(strength > 0.0) || !magic_gi_sh4_finite_vec4(control) ||
			!(control.z > 0.0) || !(ao > 0.0) || all(equal(albedo, vec3(0.0))) ||
			abs(control.w - 4.0) < 0.01) {
		return;
	}
	vec3 incident;
	float coverage;
	if (!frp_magic_gi_dynamic_volume_sample(world, geometric_normal_world,
			shading_normal_world, view, incident, coverage)) {
		return;
	}
	incident = max(incident, vec3(0.0));
	if (control.y > 0.5) {
		// Successful samples already normalize radiance by their valid tap mass.
		// That mass is cache support, not physical visibility. Leaving (1-coverage)
		// of the unoccluded sky here adds light through closed walls whenever an
		// edge or LOD has missing taps. The current PRT result owns sky transport.
		ambient_light -= global_sky_light_diffuse * clamp(strength, 0.0, 1.0);
	}
	ambient_light += incident * albedo * ao * diffuse_ao * strength * control.z;
}

#endif // FRP_MAGIC_GI_DYNAMIC_VOLUME_GLSLINC
