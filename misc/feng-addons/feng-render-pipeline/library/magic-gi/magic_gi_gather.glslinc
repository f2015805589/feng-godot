// One reconstruction kernel for direct evaluation and CLV filling.
#ifndef MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT
#define MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT 16
#endif
#ifndef MAGIC_GI_WIDE_VISIBLE_PROBE_LIMIT
#define MAGIC_GI_WIDE_VISIBLE_PROBE_LIMIT 8
#endif
const float SURFACE_FALLBACK_COVERAGE_LOW = 0.01;
const float SURFACE_FALLBACK_COVERAGE_HIGH = 0.05;

bool probe_connection_visible(vec3 sample_position, vec3 world, int receiver_triangle,
		int receiver_patch, bool curved_patch, vec3 biased_world, int endpoint_triangle) {
	return params.control.w <= 0.5 || !(segment_blocked(sample_position, world, receiver_triangle,
			curved_patch ? receiver_patch : 0) || (curved_patch
			&& segment_blocked(sample_position, biased_world, endpoint_triangle, 0)));
}

void accumulate_probe_lighting(int probe, float normal_match, float weight, float visibility,
		float score, float kernel_epsilon, float coverage_base, bool angular, bool directional_source,
		float receiving_basis[9], inout vec4 coefficients[18], inout vec3 indirect,
		inout float unoccluded_weight, inout vec3 primary_sky_indirect,
		inout float primary_sky_weight, inout float visible_support_weight,
		inout float coverage_confidence) {
	unoccluded_weight += weight;
	if (visibility <= 0.0001) { return; }
	visible_support_weight += weight * visibility;
	coverage_confidence = max(coverage_confidence,
			clamp(coverage_base * visibility, 0.0, 1.0));
	if (angular) {
		for (int k = 0; k < 9; k++) {
			coefficients[k] += directional_lighting.values[probe * 20 + k] * weight * visibility;
		}
	} else {
		vec3 response = probe_lighting.values[probe * 2].rgb;
		if (directional_source) {
			response = directional_lighting.values[probe * 20 + 18].rgb;
			if (normal_match < 0.9998) {
				response = vec3(0.0);
				for (int k = 0; k < 9; k++) {
					response += directional_lighting.values[probe * 20 + k].rgb * receiving_basis[k];
				}
			}
		}
		indirect += response * weight * visibility;
	}
	if (directional_source || params.control.z > 0.5) {
		// Keep the local primary-sky kernel narrower than the secondary field.
		float sky_weight = weight * kernel_epsilon / max(kernel_epsilon + score, 1e-7);
		float visible_sky_weight = sky_weight * visibility;
		if (angular) {
			for (int k = 0; k < 9; k++) {
				coefficients[9 + k] += directional_lighting.values[probe * 20 + 9 + k] * visible_sky_weight;
			}
		} else {
			vec3 response = probe_lighting.values[probe * 2 + 1].rgb;
			if (directional_source) {
				response = directional_lighting.values[probe * 20 + 19].rgb;
				if (normal_match < 0.9998) {
					response = vec3(0.0);
					for (int k = 0; k < 9; k++) {
						response += directional_lighting.values[probe * 20 + 9 + k].rgb * receiving_basis[k];
					}
				}
			}
			primary_sky_indirect += response * visible_sky_weight;
		}
		primary_sky_weight += visible_sky_weight;
	}
}

void gather_probe_neighborhood(vec3 world, vec3 normal_world, int receiver_triangle,
		bool angular, bool directional_source, bool wide_surface_fallback, bool same_patch_only,
		out vec4 coefficients[18], out float candidate_weight, out float visible_support_weight,
		out float coverage_confidence) {
	if (angular) { for (int k = 0; k < 18; k++) { coefficients[k] = vec4(0.0); } }
	else { coefficients[0] = vec4(0.0); coefficients[9] = vec4(0.0); }
	float receiving_basis[9];
	if (directional_source && !angular) { diffuse_basis(normal_world, receiving_basis); }
	float spacing = max(params.control.y, 0.001);
	vec3 dimensions = params.grid.xyz;
	vec3 grid_position = clamp((params.world_to_grid * vec4(world, 1.0)).xyz, vec3(0.0), dimensions);
	ivec3 grid_dims = ivec3(dimensions);
	ivec3 center = clamp(ivec3(floor(grid_position)), ivec3(0), grid_dims - 1);
	vec3 indirect = vec3(0.0);
	float unoccluded_weight = 0.0;
	vec3 primary_sky_indirect = vec3(0.0);
	float primary_sky_weight = 0.0;
	candidate_weight = 0.0;
	visible_support_weight = 0.0;
	coverage_confidence = 0.0;
	int selected_probe[MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT];
	float selected_score[MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT];
	float selected_weight[MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT];
	float selected_coverage[MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT];
	if (wide_surface_fallback) {
		for (int selected = 0; selected < MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT; selected++) {
			selected_probe[selected] = -1;
			selected_score[selected] = 1e30;
			selected_weight[selected] = 0.0;
			selected_coverage[selected] = 0.0;
		}
	}
	float receiver_bias = max(0.001, spacing * 0.002);
	vec3 biased_world = world + normal_world * receiver_bias;
	int endpoint_triangle = receiver_triangle;
	bool clearance_resolved = false;
	int receiver_patch = receiver_triangle >= 0 ? int(visibility_geometry.triangles[receiver_triangle * 3 + 2].w) : 0;
	if (params.control.w > 0.5) {
		biased_world = world;
	}
	float variance_floor = max(0.0001, spacing * spacing * 0.0001);
	// The global one-probe-per-world-cell layout is sparse relative to the Volume's
	// lookup grid. Keep a wider fixed support, while feathering only its outer shell.
	// Inner cells remain fully weighted so occupied nearby cells cannot disappear at
	// a lookup-grid boundary.
	vec3 grid_fraction = grid_position - vec3(center);
	float back_tolerance = max(spacing * 0.12, 0.02);
	float kernel_epsilon = max(spacing * spacing * 0.16, 0.0001);
	for (int dz = -LOOKUP_CELL_RADIUS; dz <= LOOKUP_CELL_RADIUS; dz++) {
		for (int dy = -LOOKUP_CELL_RADIUS; dy <= LOOKUP_CELL_RADIUS; dy++) {
			for (int dx = -LOOKUP_CELL_RADIUS; dx <= LOOKUP_CELL_RADIUS; dx++) {
				ivec3 cell = center + ivec3(dx, dy, dz);
				if (any(lessThan(cell, ivec3(0))) || any(greaterThanEqual(cell, grid_dims))) {
					continue;
				}
				ivec3 cell_offset = cell - center;
				float cell_window = 1.0;
				for (int axis = 0; axis < 3; axis++) {
					if (abs(cell_offset[axis]) == LOOKUP_CELL_RADIUS) {
						if (cell_offset[axis] < 0) {
							cell_window *= 1.0 - smoothstep(0.0, 1.0, grid_fraction[axis]);
						} else {
							cell_window *= smoothstep(0.0, 1.0, grid_fraction[axis]);
						}
					}
				}
				if (cell_window <= 0.0) {
					continue;
				}
				int cell_count = cell_probe_count(cell, grid_dims);
				for (int slot = 0; slot < cell_count; slot++) {
					int probe = cell_probe(cell, slot, grid_dims);
					if (probe < 0) {
						break; // Build slots are dense; the remaining slots in this cell are empty.
					}
					if (float(probe) >= params.grid.w) {
						continue;
					}
					ivec2 geometry_xy = ivec2((probe % 32) * 3, probe / 32);
					vec4 surface_record = texelFetch(geometry_atlas, geometry_xy, 0);
					vec3 sample_surface = surface_record.xyz;
					vec3 sample_position = texelFetch(geometry_atlas, geometry_xy + ivec2(1, 0), 0).xyz;
					vec4 normal_record = texelFetch(geometry_atlas, geometry_xy + ivec2(2, 0), 0);
					vec3 sample_normal = normalize(normal_record.xyz);
					float normal_match = dot(normal_world, sample_normal);
					if (same_patch_only && (receiver_patch <= 0 || int(surface_record.w) != receiver_patch)) { continue; }
					vec3 surface_delta = world - sample_surface;
					// Fine probes describe local detail. Their support must shrink with
					// placement density, otherwise every pixel traces hundreds of distant
					// fine candidates and their light is blurred across the whole room.
					float local_spacing = directional_source ? max(normal_record.w, 0.001) : spacing;
					float density_window = 1.0;
					if (local_spacing < spacing * 0.999 && !wide_surface_fallback) {
						float support = local_spacing * 2.5;
						float surface_distance_squared = dot(surface_delta, surface_delta);
						if (surface_distance_squared >= support * support) { continue; }
						density_window = 1.0 - smoothstep(local_spacing * 1.5, support, sqrt(surface_distance_squared));
					}
					// Curved same-surface samples have opposite signed planes that cancel;
					// parallel samples behind the receiver keep negative same-sign distances.
					float sample_plane_distance = dot(surface_delta, sample_normal);
					float receiver_signed_plane_distance = dot(surface_delta, normal_world);
					float symmetric_plane_distance = 0.5 * (sample_plane_distance + receiver_signed_plane_distance);
					float plane_residual = abs(sample_plane_distance + receiver_signed_plane_distance);
					float gate = smoothstep(-back_tolerance, -back_tolerance * 0.3, symmetric_plane_distance)
							* (1.0 - smoothstep(spacing * 0.55, spacing * 0.85, symmetric_plane_distance))
							* smoothstep(0.15, 0.5, normal_match);
					if (gate <= 0.0) {
						continue;
					}
					float normalized_residual = plane_residual / (0.25 * spacing);
					// Flat/parallel candidates always need a direct visible segment.
					// Only a convex continuation of this connected smooth patch may use
					// the checked outward endpoint to avoid sparse curved self-shadowing.
					bool curved_patch = params.control.w > 0.5 && receiver_patch > 0
							&& int(surface_record.w) == receiver_patch && normal_match < 0.95
							&& sample_plane_distance < -0.00001 && receiver_signed_plane_distance > 0.00001
							&& plane_residual < spacing * 0.15;
					if (curved_patch && !clearance_resolved && !wide_surface_fallback) {
						// Curved receivers may interpolate around their own continuous patch.
						// This endpoint is only used after a direct check against other patches.
						float clearance = spacing * 0.3;
						int clearance_triangle;
						vec3 clearance_hit = nearest_surface(world + normal_world * clearance * 0.5,
								normal_world, clearance * 0.5, receiver_triangle, clearance_triangle);
						if (clearance_triangle >= 0) {
							clearance = max(0.0, dot(clearance_hit - world, normal_world) * 0.5 - 0.00001);
						} else if (clearance_triangle == -2) {
							clearance = 0.0;
						}
						biased_world = world + normal_world * clearance;
						endpoint_triangle = clearance > 0.00001 ? -1 : receiver_triangle;
						clearance_resolved = true;
					}
					vec3 candidate_target = params.control.w > 0.5 && !curved_patch ? world : biased_world;
					vec3 visibility_delta = candidate_target - sample_position;
					float distance_squared = dot(visibility_delta, visibility_delta);
					float score = distance_squared
							+ symmetric_plane_distance * symmetric_plane_distance * 4.0
							+ (1.0 - normal_match) * (1.0 - normal_match) * spacing * spacing
							+ normalized_residual * normalized_residual * spacing * spacing;
					float weight = gate * cell_window * density_window * inversesqrt(kernel_epsilon + score);
					if (directional_source) { weight *= max(normal_record.w * normal_record.w, 1e-6); }
					candidate_weight += weight;
					if (wide_surface_fallback) {
						int insert_at = MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT;
						for (int selected = 0; selected < MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT; selected++) {
							if (score < selected_score[selected]) {
								insert_at = selected;
								break;
							}
						}
						if (insert_at < MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT) {
							for (int shift = MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT - 1; shift > insert_at; shift--) {
								selected_probe[shift] = selected_probe[shift - 1];
								selected_score[shift] = selected_score[shift - 1];
								selected_weight[shift] = selected_weight[shift - 1];
								selected_coverage[shift] = selected_coverage[shift - 1];
							}
							selected_probe[insert_at] = probe;
							selected_score[insert_at] = score;
							selected_weight[insert_at] = weight;
							selected_coverage[insert_at] = gate * cell_window;
						}
						continue;
					}
					// A complete geometry query supersedes the coarse directional moments.
					// Near corners their angular footprint includes an adjacent wall even
					// when this connection is visible, producing dark probe-shaped patches.
					if (!probe_connection_visible(sample_position, world, receiver_triangle,
							receiver_patch, curved_patch, biased_world, endpoint_triangle)) {
						continue;
					}
					float visibility_distance = length(visibility_delta);
					float visibility = 1.0;
					if (params.control.w < 0.5 && visibility_distance > 1e-6) {
						vec2 moments = sample_visibility_moments(probe, visibility_delta / visibility_distance);
						visibility = chebyshev_visibility(moments, visibility_distance, variance_floor);
					}
					accumulate_probe_lighting(probe, normal_match, weight, visibility, score,
							kernel_epsilon, gate * cell_window * density_window, angular,
							directional_source, receiving_basis, coefficients, indirect,
							unoccluded_weight, primary_sky_indirect, primary_sky_weight,
							visible_support_weight, coverage_confidence);
				}
			}
		}
	}
	if (wide_surface_fallback) {
		int visible_probe_count = 0;
		// Candidates are score-sorted. A blocked near probe doesn't consume the
		// lighting budget; keep checking the bounded pool until eight are visible.
		for (int selected = 0; selected < MAGIC_GI_WIDE_CANDIDATE_POOL_LIMIT; selected++) {
			if (visible_probe_count >= MAGIC_GI_WIDE_VISIBLE_PROBE_LIMIT) { break; }
			int probe = selected_probe[selected];
			if (probe < 0) { continue; }
			ivec2 geometry_xy = ivec2((probe % 32) * 3, probe / 32);
			vec4 surface_record = texelFetch(geometry_atlas, geometry_xy, 0);
			vec3 sample_surface = surface_record.xyz;
			vec3 sample_position = texelFetch(geometry_atlas, geometry_xy + ivec2(1, 0), 0).xyz;
			vec4 normal_record = texelFetch(geometry_atlas, geometry_xy + ivec2(2, 0), 0);
			vec3 sample_normal = normalize(normal_record.xyz);
			float normal_match = dot(normal_world, sample_normal);
			vec3 surface_delta = world - sample_surface;
			float sample_plane_distance = dot(surface_delta, sample_normal);
			float receiver_signed_plane_distance = dot(surface_delta, normal_world);
			float plane_residual = abs(sample_plane_distance + receiver_signed_plane_distance);
			bool curved_patch = params.control.w > 0.5 && receiver_patch > 0
					&& int(surface_record.w) == receiver_patch && normal_match < 0.95
					&& sample_plane_distance < -0.00001 && receiver_signed_plane_distance > 0.00001
					&& plane_residual < spacing * 0.15;
			if (curved_patch && !clearance_resolved) {
				float clearance = spacing * 0.3;
				int clearance_triangle;
				vec3 clearance_hit = nearest_surface(world + normal_world * clearance * 0.5,
						normal_world, clearance * 0.5, receiver_triangle, clearance_triangle);
				if (clearance_triangle >= 0) {
					clearance = max(0.0, dot(clearance_hit - world, normal_world) * 0.5 - 0.00001);
				} else if (clearance_triangle == -2) {
					clearance = 0.0;
				}
				biased_world = world + normal_world * clearance;
				endpoint_triangle = clearance > 0.00001 ? -1 : receiver_triangle;
				clearance_resolved = true;
			}
			if (!probe_connection_visible(sample_position, world, receiver_triangle,
					receiver_patch, curved_patch, biased_world, endpoint_triangle)) {
				continue;
			}
			visible_probe_count++;
			float weight = selected_weight[selected];
			accumulate_probe_lighting(probe, normal_match, weight, 1.0,
					selected_score[selected], kernel_epsilon, selected_coverage[selected],
					angular, directional_source, receiving_basis, coefficients, indirect,
					unoccluded_weight, primary_sky_indirect, primary_sky_weight,
					visible_support_weight, coverage_confidence);
		}
	}
	if (angular) {
		for (int k = 0; k < 9; k++) {
			coefficients[k] /= max(unoccluded_weight, 1e-7);
			coefficients[k + 9] /= max(primary_sky_weight, 1e-7);
		}
	} else {
		coefficients[0] = vec4(indirect / max(unoccluded_weight, 1e-7), 0.0);
		coefficients[9] = vec4(primary_sky_indirect / max(primary_sky_weight, 1e-7), 0.0);
	}
}

// Shared entry point for exact surface evaluation and CLV reconstruction. The
// narrow neighborhood stays the default; only weak directional coverage with a
// complete static BVH can request a same-patch wide gather.
void gather_probe_field(vec3 world, vec3 normal_world, int receiver_triangle,
		bool angular, bool directional_source, out vec4 coefficients[18],
		out float candidate_weight, out float visible_support_weight) {
	float narrow_candidate_weight = 0.0;
	float narrow_visible_support_weight = 0.0;
	float narrow_coverage_confidence = 0.0;
	gather_probe_neighborhood(world, normal_world, receiver_triangle, angular, directional_source,
			false, false, coefficients, narrow_candidate_weight,
			narrow_visible_support_weight, narrow_coverage_confidence);
	candidate_weight = narrow_candidate_weight;
	visible_support_weight = narrow_visible_support_weight;
	int receiver_patch = receiver_triangle >= 0
			? int(visibility_geometry.triangles[receiver_triangle * 3 + 2].w) : 0;
	if (!directional_source || params.control.w < 0.5 || receiver_patch <= 0
			|| narrow_coverage_confidence >= SURFACE_FALLBACK_COVERAGE_HIGH) {
		return;
	}

	vec4 wide_coefficients[18];
	float wide_candidate_weight = 0.0;
	float wide_visible_support_weight = 0.0;
	float wide_coverage_confidence = 0.0;
	gather_probe_neighborhood(world, normal_world, receiver_triangle, angular, directional_source,
			true, true, wide_coefficients, wide_candidate_weight,
			wide_visible_support_weight, wide_coverage_confidence);
	// Preserve the original candidate accumulator whenever the narrow geometric
	// neighborhood contains any candidate. If it is empty, same-patch wide geometry
	// can establish support even when every checked connection is blocked.
	if (narrow_candidate_weight <= 0.0) {
		candidate_weight = wide_candidate_weight;
	}
	if (wide_visible_support_weight <= 1e-10) {
		return;
	}

	float narrow_mix = smoothstep(SURFACE_FALLBACK_COVERAGE_LOW,
			SURFACE_FALLBACK_COVERAGE_HIGH, narrow_coverage_confidence);
	float wide_mix = 1.0 - narrow_mix;
	if (angular) {
		for (int k = 0; k < 18; k++) {
			coefficients[k] = wide_coefficients[k] * wide_mix + coefficients[k] * narrow_mix;
		}
	} else {
		coefficients[0] = wide_coefficients[0] * wide_mix + coefficients[0] * narrow_mix;
		coefficients[9] = wide_coefficients[9] * wide_mix + coefficients[9] * narrow_mix;
	}
	visible_support_weight = wide_visible_support_weight * wide_mix
			+ narrow_visible_support_weight * narrow_mix;
}
