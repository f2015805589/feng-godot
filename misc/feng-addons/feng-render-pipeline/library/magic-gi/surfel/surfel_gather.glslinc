#ifndef FENG_GI_SURFEL_GATHER_GLSLINC
#define FENG_GI_SURFEL_GATHER_GLSLINC

layout(set = 0, binding = 29, rgba16f) uniform image2D gi_surfel_gather_color;
layout(set = 0, binding = 30, rgba16f) uniform writeonly image2D gi_surfel_gather_output;
layout(set = 0, binding = 31) uniform sampler2D gi_surfel_gather_depth;
layout(set = 0, binding = 32) uniform sampler2D gi_surfel_gather_normal;
layout(set = 0, binding = 33) uniform sampler2D gi_surfel_gather_albedo;
layout(set = 0, binding = 34) uniform sampler2D gi_surfel_gather_orm;
layout(set = 0, binding = 35) uniform sampler2D gi_surfel_gather_sky_diffuse;
layout(set = 0, binding = 36) uniform sampler2D gi_surfel_gather_diffuse_ao;
layout(set = 0, binding = 37, std140) uniform FENGGISurfelGatherParameters {
	vec4 values; // Strength, SkyLight replacement enabled, frame token, reserved.
} gi_surfel_gather_parameters;

const uint GI_SURFEL_GATHER_MATERIAL_MODEL_MASK = 0x0fu;
const uint GI_SURFEL_GATHER_UNLIT_MATERIAL_MODEL = 0u;

void gi_surfel_gather() {
	ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
	ivec2 extent = imageSize(gi_surfel_gather_color);
	if (any(greaterThanEqual(pixel, extent))) return;
	imageStore(gi_surfel_gather_output, pixel, vec4(0.0));
	float depth = texelFetch(gi_surfel_gather_depth, pixel, 0).r;
	if (!(depth > 0.0) || isnan(depth) || isinf(depth)) return;
	vec4 orm = texelFetch(gi_surfel_gather_orm, pixel, 0);
	uint material_model = uint(round(clamp(orm.a, 0.0, 1.0) * 255.0))
			& GI_SURFEL_GATHER_MATERIAL_MODEL_MASK;
	if (material_model == GI_SURFEL_GATHER_UNLIT_MATERIAL_MODEL) return;
	vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
	vec4 view_h = gi_frame.data.inverse_projection * vec4(uv * 2.0 - 1.0, depth, 1.0);
	if (!(abs(view_h.w) > 1e-8) || isnan(view_h.w) || isinf(view_h.w)) return;
	vec3 view_position = view_h.xyz / view_h.w;
	vec3 world_position = (gi_frame.data.view_to_world * vec4(view_position, 1.0)).xyz;
	vec3 owner_local = (gi_surfel_config.world_to_owner * vec4(world_position, 1.0)).xyz;
	vec3 half_extent = gi_surfel_config.owner_size_cell_radius.xyz * 0.5;
	// TAA inverse projection can round an edge sample a few float ULPs outside.
	vec3 bounds_epsilon = max(half_extent, vec3(1.0)) * 1.9073486328125e-6;
	if (any(greaterThan(abs(owner_local), half_extent + bounds_epsilon))) return;
	vec3 normal_view = texelFetch(gi_surfel_gather_normal, pixel, 0).xyz * 2.0 - 1.0;
	float normal_length = length(normal_view);
	if (!(normal_length > 1e-6) || isnan(normal_length) || isinf(normal_length)) return;
	vec3 normal = normalize(mat3(gi_frame.data.view_to_world) * (normal_view / normal_length));
	vec3 incident_over_pi;
	float coverage;
	float age;
	uint frame_token = gi_surfel_config.limits.w;
	if (!gi_surfel_lookup_visible(world_position, normal, 0xffffffffu, frame_token,
			incident_over_pi, coverage, age) || !(coverage > 0.0)) return;
	float strength = max(gi_surfel_gather_parameters.values.x, 0.0);
	float pre_exposure = max(gi_frame.data.size_exposure.z, 0.0);
	float scene_normalization = max(gi_frame.data.size_exposure.w, 0.0);
	float ao = clamp(orm.r, 0.0, 1.0);
	float diffuse_ao = textureLod(gi_surfel_gather_diffuse_ao, uv, 0.0).r;
	if (isnan(diffuse_ao) || isinf(diffuse_ao)) diffuse_ao = 1.0;
	vec3 albedo = max(texelFetch(gi_surfel_gather_albedo, pixel, 0).rgb, vec3(0.0));
	float metallic = clamp(orm.b, 0.0, 1.0);
	vec3 contribution = incident_over_pi * albedo * (1.0 - metallic) * ao
			* clamp(diffuse_ao, 0.0, 1.0) * strength * coverage
			* pre_exposure * scene_normalization;
	float ownership_weight = gi_surfel_gather_parameters.values.y > 0.5
			? clamp(strength, 0.0, 1.0) * coverage : 0.0;
	vec4 scene = imageLoad(gi_surfel_gather_color, pixel);
	if (ownership_weight > 0.0) {
		vec3 sky = texelFetch(gi_surfel_gather_sky_diffuse, pixel, 0).rgb;
		scene.rgb -= sky * ownership_weight;
	}
	imageStore(gi_surfel_gather_color, pixel, vec4(scene.rgb + contribution, scene.a));
	float debug_view = gi_surfel_config.control.w;
	if (debug_view > 0.5) {
		vec3 debug_color = incident_over_pi / (vec3(1.0) + incident_over_pi);
		if (debug_view > 1.5 && debug_view < 2.5) {
			debug_color = vec3(coverage, 1.0 - coverage, 0.15);
		} else if (debug_view > 2.5) {
			float age_fraction = clamp(age / float(GI_SURFEL_TTL_FRAMES), 0.0, 1.0);
			debug_color = vec3(age_fraction, 1.0 - age_fraction, 0.1);
		}
		imageStore(gi_surfel_gather_output, pixel, vec4(debug_color, ownership_weight));
	} else {
		imageStore(gi_surfel_gather_output, pixel, vec4(contribution, ownership_weight));
	}
}

#endif // FENG_GI_SURFEL_GATHER_GLSLINC
