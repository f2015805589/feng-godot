#ifndef FENG_GI_SURFEL_FILTER_GLSLINC
#define FENG_GI_SURFEL_FILTER_GLSLINC

const uint GI_SURFEL_FILTER_MAX_NEIGHBORS = 16u;
const float GI_SURFEL_FILTER_SUPPORT_RADII = 3.5;
const float GI_SURFEL_FILTER_NORMAL_COSINE = 0.995;
const float GI_SURFEL_FILTER_CELL_EPSILON = 1.9073486328125e-6;

float gi_surfel_filter_sample_variance(uint index) {
	vec4 statistics = gi_surfel_load_statistics(index);
	return max(statistics.a - dot(statistics.rgb, statistics.rgb) / 3.0, 0.0);
}

bool gi_surfel_filter_cell_can_contribute(ivec3 cell, vec3 center_position,
		vec3 center_normal, float support_squared, float current_worst_weight, uint level) {
	vec3 owner_origin = gi_surfel_config.owner_to_world[3].xyz;
	float cell_size = max(2.0 * gi_surfel_radius_for_level(level), 0.002);
	vec3 cell_minimum = owner_origin + vec3(cell) * cell_size;
	vec3 cell_maximum = cell_minimum + vec3(cell_size);
	vec3 bounds_epsilon = max(max(abs(cell_minimum), abs(cell_maximum)), vec3(1.0))
			* GI_SURFEL_FILTER_CELL_EPSILON;
	cell_minimum -= bounds_epsilon;
	cell_maximum += bounds_epsilon;
	vec3 nearest = max(max(cell_minimum - center_position,
			center_position - cell_maximum), vec3(0.0));
	float minimum_distance_squared = dot(nearest, nearest);
	if (!(minimum_distance_squared < support_squared)) return false;
	vec3 from_center_minimum = cell_minimum - center_position;
	vec3 from_center_maximum = cell_maximum - center_position;
	float plane_minimum = min(center_normal.x * from_center_minimum.x,
			center_normal.x * from_center_maximum.x)
		+ min(center_normal.y * from_center_minimum.y,
			center_normal.y * from_center_maximum.y)
		+ min(center_normal.z * from_center_minimum.z,
			center_normal.z * from_center_maximum.z);
	float plane_maximum = max(center_normal.x * from_center_minimum.x,
			center_normal.x * from_center_maximum.x)
		+ max(center_normal.y * from_center_minimum.y,
			center_normal.y * from_center_maximum.y)
		+ max(center_normal.z * from_center_minimum.z,
			center_normal.z * from_center_maximum.z);
	float plane_tolerance = max(0.0005, gi_surfel_config.owner_size_cell_radius.w * 0.05);
	if (plane_minimum > plane_tolerance || plane_maximum < -plane_tolerance) return false;
	float distance_fraction = sqrt(minimum_distance_squared / support_squared);
	float compact_upper = max(1.0 - distance_fraction, 0.0);
	compact_upper = compact_upper * compact_upper * compact_upper * compact_upper
			* (1.0 + 4.0 * distance_fraction);
	// Normalized float normals can dot a few ULPs above one; retain a conservative bound.
	return compact_upper * 1.001 >= current_worst_weight;
}

bool gi_surfel_filter_candidate(uint index, ivec3 cell, FENGGISurfelRecord center,
		vec3 center_normal, float support_squared, uint frame_token, uint level,
		out float weight) {
	weight = 0.0;
	if (index >= gi_surfel_config.limits.x) return false;
	FENGGISurfelRecord candidate = gi_surfel_load_record(index);
	if (candidate.normal_valid.w < 0.5 || candidate.state.z != 0u
			|| candidate.surface.z == GI_SURFEL_UNKNOWN_INSTANCE
			|| candidate.surface.w == GI_SURFEL_UNKNOWN_INSTANCE
			|| any(notEqual(candidate.cell_last_seen.xyz, cell))
			|| gi_surfel_tracking.values[index].z != level
			|| !gi_surfel_tracking_matches(index, candidate)
			|| (candidate.surface.x & center.surface.x) == 0u) return false;
	uint frame_age = frame_token - uint(candidate.cell_last_seen.w);
	if (frame_age > GI_SURFEL_TTL_FRAMES) return false;
	vec3 candidate_normal = normalize(candidate.normal_valid.xyz);
	float normal_match = dot(center_normal, candidate_normal);
	if (normal_match < GI_SURFEL_FILTER_NORMAL_COSINE) return false;
	vec3 delta = candidate.position_radius.xyz - center.position_radius.xyz;
	float distance_squared = dot(delta, delta);
	if (!(distance_squared > 1e-10) || !(distance_squared < support_squared)) return false;
	float plane_tolerance = max(0.0005, gi_surfel_config.owner_size_cell_radius.w * 0.05);
	if (abs(dot(delta, center_normal)) > plane_tolerance
			|| abs(dot(-delta, candidate_normal)) > plane_tolerance) return false;
	float distance_fraction = sqrt(distance_squared / support_squared);
	float compact = max(1.0 - distance_fraction, 0.0);
	compact = compact * compact * compact * compact * (1.0 + 4.0 * distance_fraction);
	float normal_weight = pow(clamp(normal_match, 0.0, 1.0), 32.0);
	float age_weight = 1.0 - smoothstep(float(GI_SURFEL_TTL_FRAMES) * 0.5,
			float(GI_SURFEL_TTL_FRAMES), float(frame_age));
	weight = compact * normal_weight * age_weight;
	if (!(weight > 0.0) || isnan(weight) || isinf(weight)) return false;
	vec4 raw = gi_surfel_load_response_previous(index);
	return raw.a > 0.5 && all(not(isnan(raw.rgb))) && all(not(isinf(raw.rgb)));
}

bool gi_surfel_filter_heap_is_worse(float weight_a, uint index_a,
		float weight_b, uint index_b) {
	return weight_a < weight_b || (weight_a == weight_b && index_a > index_b);
}

bool gi_surfel_filter_heap_is_better(float weight_a, uint index_a,
		float weight_b, uint index_b) {
	return weight_a > weight_b || (weight_a == weight_b && index_a < index_b);
}

int gi_surfel_filter_center_first_offset(int order) {
	return order == 0 ? 0 : (order == 1 ? -1 : (order == 2 ? 1 : (order == 3 ? -2 : 2)));
}

void gi_surfel_filter_update(uint launch_index) {
	uint capacity = gi_surfel_config.limits.x;
	uint update_count = min(gi_surfel_probe_config.budget.x, capacity);
	uint active_count = min(capacity, gi_surfel_load_counter(1u));
	uint surface_budget = gi_surfel_probe_surface_budget(active_count);
	if (launch_index >= update_count || launch_index >= surface_budget) return;
	uint index = gi_surfel_update_queue.indices[capacity + launch_index];
	if (index >= capacity || gi_surfel_pending_results.values[launch_index].w != 1u) return;
	FENGGISurfelRecord center = gi_surfel_load_record(index);
	vec4 center_raw = gi_surfel_load_response_previous(index);
	if (center.normal_valid.w < 0.5 || center.state.z != 0u
			|| center.surface.z == GI_SURFEL_UNKNOWN_INSTANCE
			|| center.surface.w == GI_SURFEL_UNKNOWN_INSTANCE
			|| center_raw.a < 0.5 || any(isnan(center_raw.rgb)) || any(isinf(center_raw.rgb))) {
		gi_surfel_store_response_filtered(index, vec4(0.0));
		return;
	}
	vec3 center_normal = normalize(center.normal_valid.xyz);
	float radius = max(center.position_radius.w, 0.001);
	float support = GI_SURFEL_FILTER_SUPPORT_RADII * radius;
	float support_squared = support * support;
	uint frame_token = gi_surfel_config.limits.w;
	ivec3 center_cell = center.cell_last_seen.xyz;
	uint center_level = gi_surfel_tracking.values[index].z;
	uint neighbor_indices[GI_SURFEL_FILTER_MAX_NEIGHBORS];
	float neighbor_weights[GI_SURFEL_FILTER_MAX_NEIGHBORS];
	for (int i = 0; i < GI_SURFEL_FILTER_MAX_NEIGHBORS; i++) {
		neighbor_indices[i] = capacity;
		neighbor_weights[i] = 0.0;
	}
	int heap_count = 0;
	for (int z_order = 0; z_order < 5; z_order++) {
		int z = gi_surfel_filter_center_first_offset(z_order);
		for (int y_order = 0; y_order < 5; y_order++) {
			int y = gi_surfel_filter_center_first_offset(y_order);
			for (int x_order = 0; x_order < 5; x_order++) {
				int x = gi_surfel_filter_center_first_offset(x_order);
				ivec3 cell = center_cell + ivec3(x, y, z);
				float worst_weight = heap_count == GI_SURFEL_FILTER_MAX_NEIGHBORS
						? neighbor_weights[0] : 0.0;
				if (!gi_surfel_filter_cell_can_contribute(cell, center.position_radius.xyz,
						center_normal, support_squared, worst_weight, center_level)) continue;
				uint slot = gi_surfel_hash_cell(cell, center_level) & gi_surfel_config.limits.y;
				for (uint probe = 0u; probe < GI_SURFEL_MAX_HASH_PROBES; probe++) {
					uint candidate_index = gi_surfel_hash.slots[slot];
					if (candidate_index == GI_SURFEL_SLOT_EMPTY) break;
					if (candidate_index < capacity && candidate_index != index) {
						float candidate_weight;
						if (gi_surfel_filter_candidate(candidate_index, cell, center,
								center_normal, support_squared, frame_token, center_level,
								candidate_weight)) {
							if (heap_count < GI_SURFEL_FILTER_MAX_NEIGHBORS) {
								int node = heap_count;
								neighbor_indices[node] = candidate_index;
								neighbor_weights[node] = candidate_weight;
								heap_count++;
								for (int step = 0; step < 4; step++) {
									if (node <= 0) break;
									int parent = (node - 1) / 2;
									if (!gi_surfel_filter_heap_is_worse(neighbor_weights[node],
											neighbor_indices[node], neighbor_weights[parent],
											neighbor_indices[parent])) break;
									uint swap_index = neighbor_indices[parent];
									float swap_weight = neighbor_weights[parent];
									neighbor_indices[parent] = neighbor_indices[node];
									neighbor_weights[parent] = neighbor_weights[node];
									neighbor_indices[node] = swap_index;
									neighbor_weights[node] = swap_weight;
									node = parent;
								}
							} else if (gi_surfel_filter_heap_is_better(candidate_weight,
									candidate_index, neighbor_weights[0], neighbor_indices[0])) {
								neighbor_indices[0] = candidate_index;
								neighbor_weights[0] = candidate_weight;
								int node = 0;
								for (int step = 0; step < 4; step++) {
									int left = node * 2 + 1;
									if (left >= GI_SURFEL_FILTER_MAX_NEIGHBORS) break;
									int worse_child = left;
									int right = left + 1;
									if (right < GI_SURFEL_FILTER_MAX_NEIGHBORS
											&& gi_surfel_filter_heap_is_worse(neighbor_weights[right],
												neighbor_indices[right], neighbor_weights[left],
												neighbor_indices[left])) worse_child = right;
									if (!gi_surfel_filter_heap_is_worse(neighbor_weights[worse_child],
											neighbor_indices[worse_child], neighbor_weights[node],
											neighbor_indices[node])) break;
									uint swap_index = neighbor_indices[worse_child];
									float swap_weight = neighbor_weights[worse_child];
									neighbor_indices[worse_child] = neighbor_indices[node];
									neighbor_weights[worse_child] = neighbor_weights[node];
									neighbor_indices[node] = swap_index;
									neighbor_weights[node] = swap_weight;
									node = worse_child;
								}
							}
						}
					}
					slot = (slot + 1u) & gi_surfel_config.limits.y;
				}
			}
		}
	}
	float geometry_weight_sum = 0.0;
	vec3 weighted_delta = vec3(0.0);
	float center_variance = gi_surfel_filter_sample_variance(index);
	float center_effective_samples = clamp(float(max(center.state.w, 1u)), 1.0, 7.0);
	float center_max_rgb = max(center_raw.r, max(center_raw.g, center_raw.b));
	for (int i = 0; i < GI_SURFEL_FILTER_MAX_NEIGHBORS; i++) {
		uint neighbor_index = neighbor_indices[i];
		if (!(neighbor_weights[i] > 0.0) || neighbor_index >= capacity) continue;
		FENGGISurfelRecord neighbor = gi_surfel_load_record(neighbor_index);
		uint common_layer = center.surface.x & neighbor.surface.x;
		if (!gi_surfel_connection_visible(center.position_radius.xyz, center_normal,
				neighbor.position_radius.xyz, neighbor.normal_valid.xyz, common_layer)) continue;
		vec4 neighbor_raw = gi_surfel_load_response_previous(neighbor_index);
		if (neighbor_raw.a < 0.5 || any(isnan(neighbor_raw.rgb)) || any(isinf(neighbor_raw.rgb))) continue;
		float geometry_weight = neighbor_weights[i];
		float neighbor_variance = gi_surfel_filter_sample_variance(neighbor_index);
		float neighbor_effective_samples = clamp(float(max(neighbor.state.w, 1u)), 1.0, 7.0);
		float pair_noise = sqrt(max(center_variance / center_effective_samples
				+ neighbor_variance / neighbor_effective_samples, 0.0));
		float neighbor_max_rgb = max(neighbor_raw.r, max(neighbor_raw.g, neighbor_raw.b));
		float pair_scale = max(max(center_max_rgb, neighbor_max_rgb), 1e-3);
		float signal_difference = length(neighbor_raw.rgb - center_raw.rgb) * 0.57735026919;
		float relative_noise = pair_noise / pair_scale;
		float noise_strength = clamp((relative_noise - 0.01) / 0.10, 0.0, 1.0);
		float signal_excess = max(signal_difference - 2.0 * pair_noise - 0.01 * pair_scale, 0.0);
		float signal_confidence = clamp(signal_excess / max(signal_difference, 0.01 * pair_scale), 0.0, 1.0);
		float pair_share = 0.9 * noise_strength * (1.0 - signal_confidence);
		geometry_weight_sum += geometry_weight;
		weighted_delta += geometry_weight * pair_share * (neighbor_raw.rgb - center_raw.rgb);
	}
	if (!(geometry_weight_sum > 1e-6)) {
		gi_surfel_store_response_filtered(index, vec4(center_raw.rgb, 1.0));
		return;
	}
	vec3 filtered = max(center_raw.rgb + weighted_delta / geometry_weight_sum, vec3(0.0));
	if (any(isnan(filtered)) || any(isinf(filtered))) {
		gi_surfel_store_response_filtered(index, vec4(0.0));
		return;
	}
	gi_surfel_store_response_filtered(index, vec4(filtered, 1.0));
}

#endif // FENG_GI_SURFEL_FILTER_GLSLINC
