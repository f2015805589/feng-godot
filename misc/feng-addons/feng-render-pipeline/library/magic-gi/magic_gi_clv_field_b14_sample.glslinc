#ifndef FENG_MAGIC_GI_LAYOUT14_NODE_VISIBILITY_SAMPLE_GLSLINC
#define FENG_MAGIC_GI_LAYOUT14_NODE_VISIBILITY_SAMPLE_GLSLINC

// Experimental B sampler: combines the layout14 raw directional SH field with
// independent node-origin distance moments. This file is included at shader
// root level; Godot's importer does not expand nested includes.
layout(set = 0, binding = 33) uniform sampler3D b14_node_visibility_moments;
const float B14_NODE_VISIBILITY_RANGE_SCALE = 4.0;
layout(set = 0, binding = 34, std430) readonly buffer B14NodeVisibilityTags {
	ivec4 values[]; // logical xyz + geometry epoch, indexed by physical clipmap slot.
} b14_node_visibility_tags;

bool b14_sample_finite4(vec4 value) {
	return !any(isnan(value)) && !any(isinf(value));
}

bool b14_unproject_depth_world(ivec2 pixel, ivec2 extent, out vec3 world_out) {
	world_out = vec3(0.0);
	if (any(lessThan(pixel, ivec2(0))) || any(greaterThanEqual(pixel, extent))) { return false; }
	float depth = texelFetch(depth_buffer, pixel, 0).r;
	if (!(depth > 0.0) || isnan(depth) || isinf(depth)) { return false; }
	vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(extent);
	vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
	vec4 view_h = params.inverse_projection * clip;
	if (any(isnan(view_h)) || any(isinf(view_h)) || abs(view_h.w) < 1e-7) { return false; }
	vec3 view_position = view_h.xyz / view_h.w;
	vec4 world_h = params.view_to_world * vec4(view_position, 1.0);
	if (any(isnan(world_h)) || any(isinf(world_h)) || abs(world_h.w) < 1e-7) { return false; }
	world_out = world_h.xyz / world_h.w;
	return b14_helper_finite3(world_out);
}

bool b14_receiver_geometry_normal(ivec2 pixel, vec3 center_world, out vec3 normal_out) {
	normal_out = vec3(0.0);
	ivec2 extent = textureSize(depth_buffer, 0);
	if (any(lessThan(extent, ivec2(3))) || pixel.x <= 0 || pixel.y <= 0
			|| pixel.x >= extent.x - 1 || pixel.y >= extent.y - 1
			|| !b14_helper_finite3(center_world)) { return false; }
	float center_depth = texelFetch(depth_buffer, pixel, 0).r;
	if (!(center_depth > 0.0) || isnan(center_depth) || isinf(center_depth)) { return false; }
	vec3 left_world, right_world, up_world, down_world;
	if (!b14_unproject_depth_world(pixel + ivec2(-1, 0), extent, left_world)
			|| !b14_unproject_depth_world(pixel + ivec2(1, 0), extent, right_world)
			|| !b14_unproject_depth_world(pixel + ivec2(0, -1), extent, up_world)
			|| !b14_unproject_depth_world(pixel + ivec2(0, 1), extent, down_world)) { return false; }
	vec3 camera_world = params.view_to_world[3].xyz;
	return b14_reconstruct_depth_geometry_normal(center_world, left_world, right_world,
			up_world, down_world, camera_world - center_world, normal_out);
}

bool b14_load_layout14_corner(int resolution, int level, float step_size,
		ivec3 logical_corner, vec3 receiver_world, vec3 receiver_geometry_normal,
		in float basis[9], out vec3 secondary_node, out vec3 primary_node,
		out float visibility_weight) {
	secondary_node = vec3(0.0);
	primary_node = vec3(0.0);
	visibility_weight = 0.0;
	ivec3 relative = logical_corner - clv.origins[level].xyz;
	if (any(lessThan(relative, ivec3(0))) || any(greaterThanEqual(relative, ivec3(resolution)))) {
		return false;
	}
	ivec3 physical = clv_wrap_logical_index(logical_corner, resolution);
	ivec3 field_slot = physical + ivec3(0, 0, level * resolution);
	ivec4 field_tag = texelFetch(clv_tags, field_slot, 0);
	uint support = texelFetch(clv_support, field_slot, 0).r;
	if (any(notEqual(field_tag.xyz, logical_corner)) || field_tag.w != clv.control.z
			|| (support & CLV_FIELD_SUPPORT_REQUIRED) != CLV_FIELD_SUPPORT_REQUIRED) { return false; }
	int physical_index = ((level * resolution + physical.z) * resolution + physical.y)
			* resolution + physical.x;
	if (physical_index < 0 || physical_index >= b14_node_visibility_tags.values.length()) { return false; }
	ivec4 node_tag = b14_node_visibility_tags.values[physical_index];
	if (!b14_node_tag_matches(node_tag, logical_corner, clv.control.z)) { return false; }
	vec3 node_world = (vec3(logical_corner) + vec3(0.5)) * step_size;
	vec2 moments = b14_sample_node_moments(b14_node_visibility_moments, physical,
			level, resolution, receiver_world - node_world);
	float node_weight = 0.0;
	if (!b14_node_receiver_weight(moments, node_world, receiver_world,
			receiver_geometry_normal, step_size, B14_NODE_VISIBILITY_RANGE_SCALE, node_weight)) { return false; }
	int padded = resolution + 1;
	ivec3 coefficient_slot = ivec3(physical.x, physical.y,
			level * padded + physical.z);
	for (int coefficient = 0; coefficient < 9; coefficient++) {
		ivec3 secondary_texel = coefficient_slot + ivec3(coefficient * padded, 0, 0);
		ivec3 primary_texel = coefficient_slot + ivec3((coefficient + 9) * padded, 0, 0);
		vec4 secondary_value = texelFetch(clv_texture, secondary_texel, 0);
		vec4 primary_value = texelFetch(clv_texture, primary_texel, 0);
		if (!b14_sample_finite4(secondary_value) || !b14_sample_finite4(primary_value)) { return false; }
		secondary_node += secondary_value.rgb * basis[coefficient];
		primary_node += primary_value.rgb * basis[coefficient];
	}
	if (!b14_helper_finite3(secondary_node) || !b14_helper_finite3(primary_node)
			|| isnan(node_weight) || isinf(node_weight)) { return false; }
	visibility_weight = node_weight;
	return true;
}

bool b14_sample_layout14_level(ivec2 pixel, vec3 world, vec3 shading_normal,
		int receiver_triangle, int level, int resolution, int level_count,
		ivec3 field_extent, in float basis[9], inout int geometry_normal_state,
		inout vec3 receiver_geometry_normal, out vec3 secondary,
		out vec3 primary) {
	secondary = vec3(0.0);
	primary = vec3(0.0);
	float step_size = clv.spacing.x * float(1 << level);
	if (!(step_size > 0.0) || isnan(step_size) || isinf(step_size)) { return false; }
	vec3 query_position;
	ivec3 base;
	vec3 fraction;
	if (!clv_surface_query_position(world, shading_normal, receiver_triangle,
			step_size, true, query_position, base, fraction)) { return false; }
	if (geometry_normal_state == 0) {
		if (b14_receiver_geometry_normal(pixel, world, receiver_geometry_normal)) {
			geometry_normal_state = 1;
		} else {
			geometry_normal_state = -1;
		}
	}
	if (geometry_normal_state != 1) { return false; }
	float secondary_weight_sum = 0.0;
	float primary_weight_sum = 0.0;
	vec3 secondary_weighted_sum = vec3(0.0);
	vec3 primary_weighted_sum = vec3(0.0);
	for (int z = 0; z <= 1; z++) {
		for (int y = 0; y <= 1; y++) {
			for (int x = 0; x <= 1; x++) {
				float trilinear_weight = (x == 0 ? 1.0 - fraction.x : fraction.x)
						* (y == 0 ? 1.0 - fraction.y : fraction.y)
						* (z == 0 ? 1.0 - fraction.z : fraction.z);
				if (!(trilinear_weight > 0.0)) { continue; }
				ivec3 logical_corner = base + ivec3(x, y, z);
				vec3 secondary_node, primary_node;
				float visibility_weight = 0.0;
				if (!b14_load_layout14_corner(resolution, level, step_size,
						logical_corner, world, receiver_geometry_normal, basis,
						secondary_node, primary_node, visibility_weight)) { return false; }
				float corner_weight = trilinear_weight * visibility_weight;
				if (isnan(corner_weight) || isinf(corner_weight) || corner_weight < 0.0) { return false; }
				// A valid zero-facing/zero-visible corner is not missing. Its zero
				// weight is retained; no missing corner is dropped and renormalized.
				secondary_weighted_sum += secondary_node * corner_weight;
				primary_weighted_sum += primary_node * corner_weight;
				secondary_weight_sum += corner_weight;
				primary_weight_sum += corner_weight;
			}
		}
	}
	if (!(secondary_weight_sum > 1e-6) || !(primary_weight_sum > 1e-6)
			|| isnan(secondary_weight_sum) || isinf(secondary_weight_sum)
			|| isnan(primary_weight_sum) || isinf(primary_weight_sum)
			|| !b14_helper_finite3(secondary_weighted_sum)
			|| !b14_helper_finite3(primary_weighted_sum)) { return false; }
	secondary = secondary_weighted_sum / secondary_weight_sum;
	primary = primary_weighted_sum / primary_weight_sum;
	return b14_helper_finite3(secondary) && b14_helper_finite3(primary);
}

bool b14_sample_layout14(ivec2 pixel, vec3 world, vec3 normal, int receiver_triangle,
		out vec3 secondary, out vec3 primary, out float cache_weight,
		out bool complete_support, out float cache_blend_weight) {
	secondary = vec3(0.0);
	primary = vec3(0.0);
	cache_weight = 0.0;
	complete_support = false;
	cache_blend_weight = 0.0;
	int resolution = clv.control.x;
	int level_count = clv.control.y;
	if (clv.control.w != CLV_FIELD_LAYOUT_VERSION || resolution < 2 || resolution > 256
			|| level_count < 1 || level_count > CLV_FIELD_LEVEL_COUNT
			|| !b14_helper_finite3(world) || !b14_helper_finite3(normal)
			|| !b14_helper_finite3(clv.spacing.yzw)) { return false; }
	float normal2 = dot(normal, normal);
	if (!(normal2 > 1e-12) || isnan(normal2) || isinf(normal2)) { return false; }
	vec3 shading_normal = normal * inversesqrt(normal2);
	ivec3 expected_tag_extent = ivec3(resolution, resolution, level_count * resolution);
	if (any(notEqual(textureSize(clv_tags, 0), expected_tag_extent))
			|| any(notEqual(textureSize(clv_support, 0), expected_tag_extent))) { return false; }
	int padded = resolution + 1;
	ivec3 field_extent = textureSize(clv_texture, 0);
	if (any(notEqual(field_extent, ivec3(18 * padded, padded, level_count * padded)))
			|| any(notEqual(textureSize(b14_node_visibility_moments, 0),
				ivec3(8 * resolution, 8 * resolution, level_count * resolution)))
			|| b14_node_visibility_tags.values.length() < level_count * resolution * resolution * resolution) {
		return false;
	}
	float basis[9];
	diffuse_basis(shading_normal, basis);
	vec3 camera_position = clv.spacing.yzw;
	float view_distance = max(max(abs(world.x - camera_position.x),
			abs(world.y - camera_position.y)), abs(world.z - camera_position.z));
	if (isnan(view_distance) || isinf(view_distance)) { return false; }
	int fine_level = level_count - 1;
	int coarse_level = fine_level;
	float coarse_weight = 0.0;
	for (int level = 0; level < level_count - 1; level++) {
		float step_size = clv.spacing.x * float(1 << level);
		float half_extent = 0.5 * float(resolution) * step_size;
		float fade_width = max(2.0 * step_size, 0.15 * half_extent);
		float fade_start = max(0.0, half_extent - fade_width);
		float fade_end = half_extent + fade_width;
		if (view_distance <= fade_start) {
			fine_level = level;
			coarse_level = level;
			coarse_weight = 0.0;
			break;
		}
		if (view_distance < fade_end) {
			fine_level = level;
			coarse_level = level + 1;
			coarse_weight = smoothstep(fade_start, fade_end, view_distance);
			break;
		}
		fine_level = level + 1;
		coarse_level = level + 1;
		coarse_weight = 0.0;
	}
	int geometry_normal_state = 0;
	vec3 receiver_geometry_normal = vec3(0.0);
	vec3 fine_secondary, fine_primary;
	bool fine_valid = b14_sample_layout14_level(pixel, world, shading_normal,
			receiver_triangle, fine_level, resolution, level_count, field_extent, basis,
			geometry_normal_state, receiver_geometry_normal, fine_secondary, fine_primary);
	vec3 coarse_secondary = vec3(0.0);
	vec3 coarse_primary = vec3(0.0);
	bool coarse_valid = false;
	if (coarse_level != fine_level) {
		coarse_valid = b14_sample_layout14_level(pixel, world, shading_normal,
				receiver_triangle, coarse_level, resolution, level_count, field_extent, basis,
				geometry_normal_state, receiver_geometry_normal, coarse_secondary, coarse_primary);
	}
	if (coarse_level == fine_level) {
		if (!fine_valid) { return false; }
		secondary = fine_secondary;
		primary = fine_primary;
	} else {
		// A selected crossfade requires both complete levels. Never drop a
		// missing positive corner or substitute another level silently.
		if (!fine_valid || !coarse_valid) { return false; }
		secondary = mix(fine_secondary, coarse_secondary, coarse_weight);
		primary = mix(fine_primary, coarse_primary, coarse_weight);
	}
	if (!b14_helper_finite3(secondary) || !b14_helper_finite3(primary)) { return false; }
	secondary = max(secondary, vec3(0.0));
	primary = max(primary, vec3(0.0));
	cache_weight = 1.0;
	complete_support = true;
	cache_blend_weight = 1.0;
	return true;
}

bool sample_clv_layout14_b(ivec2 pixel, vec3 world, vec3 normal,
		int receiver_triangle, int receiver_patch, out vec3 secondary,
		out vec3 primary, out float cache_weight, out bool complete_support,
		out float cache_blend_weight) {
	if (clv.control.w == CLV_FIELD_LAYOUT_VERSION) {
		return b14_sample_layout14(pixel, world, normal, receiver_triangle,
				secondary, primary, cache_weight, complete_support, cache_blend_weight);
	}
	return sample_clv_r7(world, normal, receiver_triangle, receiver_patch,
			secondary, primary, cache_weight, complete_support, cache_blend_weight);
}

#endif