#version 460
#extension GL_EXT_ray_tracing : require

struct GIPathPayload {
	vec3 radiance;
	uint flags;
	float hit_distance;
};

struct GIFrameData {
	mat4 inverse_projection;
	mat4 view_to_world;
	vec4 size_exposure;
	vec4 light_sky_parameters;
	vec4 world_to_sky_columns[3];
	uvec4 sun_view_generation_sky_array;
	vec4 trace_parameters;
	uvec4 generation_history_flags;
};

layout(set = 0, binding = 0) uniform accelerationStructureEXT gi_scene_tlas;
layout(set = 0, binding = 1) uniform sampler2D gi_depth;
layout(set = 0, binding = 2) uniform sampler2D gi_normal_roughness;
layout(set = 0, binding = 3) uniform sampler2D gi_albedo;
layout(set = 0, binding = 4) uniform sampler2D gi_orm;
layout(set = 0, binding = 20, std140) uniform GIFrame {
	GIFrameData data;
} gi_frame;
layout(set = 0, binding = 21, rgba16f) uniform writeonly image2D gi_output;

layout(location = 0) rayPayloadEXT GIPathPayload gi_payload;

const uint GI_RAY_MODE_PRIMARY = 0u;
const uint GI_MATERIAL_MODEL_MASK = 0x0fu;
const uint GI_UNLIT_MATERIAL_MODEL = 0u;
const float GI_HALF_MAX = 65504.0;

uint gi_hash(uint p_value) {
	p_value ^= p_value >> 16u;
	p_value *= 0x7feb352du;
	p_value ^= p_value >> 15u;
	p_value *= 0x846ca68bu;
	p_value ^= p_value >> 16u;
	return p_value;
}

float gi_random(inout uint p_state) {
	p_state = gi_hash(p_state);
	return float(p_state) * (1.0 / 4294967296.0);
}

vec3 gi_finite_nonnegative(vec3 p_value) {
	return vec3(
			isnan(p_value.x) || isinf(p_value.x) ? 0.0 : max(p_value.x, 0.0),
			isnan(p_value.y) || isinf(p_value.y) ? 0.0 : max(p_value.y, 0.0),
			isnan(p_value.z) || isinf(p_value.z) ? 0.0 : max(p_value.z, 0.0));
}

ivec2 gi_uv_to_texel(vec2 p_uv, ivec2 p_size) {
	return clamp(ivec2(floor(p_uv * vec2(p_size))), ivec2(0), p_size - ivec2(1));
}

void gi_store_invalid(ivec2 p_pixel) {
	imageStore(gi_output, p_pixel, vec4(0.0));
}

void main() {
	ivec2 output_size = imageSize(gi_output);
	ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
	if (any(greaterThanEqual(pixel, output_size))) {
		return;
	}

	vec2 uv = (vec2(pixel) + 0.5) / vec2(output_size);
	ivec2 depth_size = textureSize(gi_depth, 0);
	ivec2 normal_size = textureSize(gi_normal_roughness, 0);
	ivec2 albedo_size = textureSize(gi_albedo, 0);
	ivec2 orm_size = textureSize(gi_orm, 0);
	ivec2 depth_pixel = gi_uv_to_texel(uv, depth_size);
	ivec2 normal_pixel = gi_uv_to_texel(uv, normal_size);
	ivec2 albedo_pixel = gi_uv_to_texel(uv, albedo_size);
	ivec2 orm_pixel = gi_uv_to_texel(uv, orm_size);

	float depth = texelFetch(gi_depth, depth_pixel, 0).r;
	if (!(depth > 0.0) || isnan(depth) || isinf(depth)) {
		gi_store_invalid(pixel);
		return;
	}
	vec4 orm = texelFetch(gi_orm, orm_pixel, 0);
	uint material_model = uint(round(clamp(orm.a, 0.0, 1.0) * 255.0)) & GI_MATERIAL_MODEL_MASK;
	if (material_model == GI_UNLIT_MATERIAL_MODEL) {
		gi_store_invalid(pixel);
		return;
	}

	vec4 view_h = gi_frame.data.inverse_projection * vec4(uv * 2.0 - 1.0, depth, 1.0);
	if (abs(view_h.w) < 1e-8 || isnan(view_h.w) || isinf(view_h.w)) {
		gi_store_invalid(pixel);
		return;
	}
	vec3 view_position = view_h.xyz / view_h.w;
	vec3 world_position = (gi_frame.data.view_to_world * vec4(view_position, 1.0)).xyz;
	vec3 normal_view_encoded = texelFetch(gi_normal_roughness, normal_pixel, 0).xyz * 2.0 - 1.0;
	float normal_length = length(normal_view_encoded);
	if (!(normal_length > 1e-6) || isnan(normal_length) || isinf(normal_length)) {
		gi_store_invalid(pixel);
		return;
	}
	vec3 normal_view = normal_view_encoded / normal_length;
	vec3 normal_world = normalize(mat3(gi_frame.data.view_to_world) * normal_view);
	vec4 albedo = texelFetch(gi_albedo, albedo_pixel, 0);
	vec3 diffuse_reflectance = max(albedo.rgb, vec3(0.0))
			* (1.0 - clamp(orm.b, 0.0, 1.0)) * clamp(orm.r, 0.0, 1.0);

	float strength = gi_frame.data.trace_parameters.y;
	float p0 = gi_frame.data.size_exposure.z;
	float scene_normalization = gi_frame.data.size_exposure.w;
	if (!(strength > 0.0) || !(p0 > 0.0) || !(scene_normalization > 0.0)
			|| isnan(strength) || isinf(strength) || isnan(p0) || isinf(p0)
			|| isnan(scene_normalization) || isinf(scene_normalization)) {
		gi_store_invalid(pixel);
		return;
	}

	uint sample_count = uint(clamp(round(gi_frame.data.trace_parameters.z), 1.0, 4.0));
	if (sample_count != 1u && sample_count != 2u && sample_count != 4u) {
		sample_count = 1u;
	}
	uint seed = gi_hash(uint(pixel.x) * 0x9e3779b9u ^ uint(pixel.y) * 0x85ebca6bu
			^ gi_frame.data.sun_view_generation_sky_array.z);
	vec3 incoming_radiance = vec3(0.0);
	float max_distance = max(gi_frame.data.trace_parameters.x, 0.001);
	for (uint sample_index = 0u; sample_index < sample_count; sample_index++) {
		float u = (float(sample_index) + gi_random(seed)) / float(sample_count);
		float v = gi_random(seed);
		float radius = sqrt(u);
		float angle = 6.28318530718 * v;
		vec3 local_direction = vec3(radius * cos(angle), radius * sin(angle), sqrt(max(0.0, 1.0 - u)));
		vec3 helper = abs(normal_world.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
		vec3 tangent = normalize(cross(helper, normal_world));
		vec3 bitangent = cross(normal_world, tangent);
		vec3 direction = normalize(tangent * local_direction.x + bitangent * local_direction.y
				+ normal_world * local_direction.z);
		gi_payload.radiance = vec3(0.0);
		gi_payload.flags = GI_RAY_MODE_PRIMARY;
		gi_payload.hit_distance = 0.0;
		traceRayEXT(gi_scene_tlas, gl_RayFlagsNoneEXT, 0x01u, 0u, 0u, 0u,
				world_position + normal_world * 0.001, 0.001, direction, max_distance, 0);
		incoming_radiance += gi_finite_nonnegative(gi_payload.radiance);
	}

	vec3 result = diffuse_reflectance * (incoming_radiance / float(sample_count));
	result = min(gi_finite_nonnegative(result) * p0 * scene_normalization * strength, vec3(GI_HALF_MAX));
	float replacement_weight = clamp(strength, 0.0, 1.0);
	imageStore(gi_output, pixel, vec4(result, replacement_weight));
}
