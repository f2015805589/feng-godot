#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D raw_gi;
layout(set=0,binding=1) uniform sampler2D depth;
layout(set=0,binding=2) uniform sampler2D normal_roughness;
layout(set=0,binding=3) uniform sampler2D albedo;
layout(set=0,binding=4) uniform sampler2D orm;
layout(set=0,binding=5) uniform sampler2D hit_distance;
layout(set=0,binding=6,rgba16f) uniform writeonly image2D signal_out;
layout(set=0,binding=7,rgba16f) uniform writeonly image2D normal_out;
layout(set=0,binding=8,r32f) uniform writeonly image2D viewz_out;
layout(set=0,binding=9,rgba16f) uniform writeonly image2D motion_out;
layout(set=0,binding=10,r32f) uniform writeonly image2D history_depth;
layout(set=0,binding=11,rgba16f) uniform writeonly image2D history_normal;
layout(set=0,binding=12,rgba16f) uniform writeonly image2D history_material;
layout(set=0,binding=13,std140) uniform Frame {
 mat4 inverse_view_projection; mat4 previous_view_projection;
 vec4 size_weight_exposure; vec4 rejection; uvec4 identity; mat4 view_to_world;
} frame;
layout(set=0,binding=14,rgba16f) uniform writeonly image2D resolved;
layout(set=0,binding=15) uniform sampler2D denoised;
layout(push_constant,std430) uniform Params { vec4 values; } pc;
void main() {
 ivec2 p=ivec2(gl_GlobalInvocationID.xy), size=imageSize(signal_out);
 if(any(greaterThanEqual(p,size))) return;
 ivec2 full=textureSize(depth,0);
 ivec2 q=min(ivec2((vec2(p)+0.5)/vec2(size)*vec2(full)),full-1);
 float z=texelFetch(depth,q,0).r;
 vec4 material=texelFetch(orm,q,0);
 bool valid=z>0.0 && (uint(round(material.a*255.0))&15u)!=0u;
 vec3 reflectance=max(texelFetch(albedo,q,0).rgb,vec3(0))*clamp(material.r,0.0,1.0)*(1.0-clamp(material.b,0.0,1.0));
 float exposure=max(pc.values.x*pc.values.z,1e-10);
 // A fixed unit conversion keeps physical radiance within FP16, independent of exposure.
 const float NRD_SCALE=0.001;
 if(pc.values.y>0.5) {
  vec3 result=texelFetch(denoised,p,0).rgb*reflectance*exposure/NRD_SCALE;
  if(!valid || any(isnan(result)) || any(isinf(result))) result=vec3(0);
  imageStore(resolved,p,vec4(clamp(result,vec3(0),vec3(65504)),valid?clamp(pc.values.z,0.0,1.0):0.0));
  return;
 }
 vec4 nr=texelFetch(normal_roughness,q,0);
 vec3 n=normalize(mat3(frame.view_to_world)*(nr.xyz*2.0-1.0));
 vec2 uv=(vec2(q)+0.5)/vec2(full);
 vec4 world=frame.inverse_view_projection*vec4(uv*2.0-1.0,z,1);
 vec3 delta=world.xyz/world.w-frame.view_to_world[3].xyz;
 float viewz=-dot(delta,frame.view_to_world[2].xyz);
 vec3 rgb=texelFetch(raw_gi,p,0).rgb/max(reflectance,vec3(1e-6))/exposure*NRD_SCALE;
 if(!valid || any(isnan(rgb)) || any(isinf(rgb))) rgb=vec3(0);
 // Equivalent to NRD_FrontEnd_PackNormalAndRoughness, encoding 2 / linear roughness.
 vec3 oct=n/max(dot(abs(n),vec3(1)),1e-6);
 float rough=max(nr.w,1.5/512.0);
 vec3 packed=vec3((oct.x+oct.y)*0.5+0.5,(oct.y-oct.x)*0.5+0.5,(oct.z<0.0?-rough:rough)*0.5+0.5);
 imageStore(signal_out,p,vec4(clamp(rgb,vec3(0),vec3(65504)),clamp(texelFetch(hit_distance,p,0).r,0.001,65504.0)));
 imageStore(normal_out,p,vec4(packed,0));
 imageStore(viewz_out,p,vec4(valid?abs(viewz):1e10));
 // Static world motion; scene-transform changes invalidate NRD history in the owner.
 imageStore(motion_out,p,vec4(0));
 imageStore(history_depth,p,vec4(valid?z:0.0));
 imageStore(history_normal,p,vec4(n,1));
 imageStore(history_material,p,vec4(reflectance,1));
}
