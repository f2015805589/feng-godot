#version 460
#extension GL_EXT_ray_tracing : require

struct GIPathPayload {
	vec3 radiance;
	uint flags;
	float hit_distance;
	float ray_pdf;
};

struct GIFrameData {
	mat4 inverse_projection;
	mat4 view_to_world;
	vec4 size_exposure;
	vec4 light_sky_parameters;
	vec4 world_to_sky_columns[3];
	uvec4 sun_view_generation_sky_array;
	vec4 trace_parameters;
	uvec4 generation_history_flags;
};

layout(set = 0, binding = 0) uniform accelerationStructureEXT gi_scene_tlas;
layout(set = 0, binding = 1) uniform sampler2D gi_depth;
layout(set = 0, binding = 2) uniform sampler2D gi_normal_roughness;
layout(set = 0, binding = 3) uniform sampler2D gi_albedo;
layout(set = 0, binding = 4) uniform sampler2D gi_orm;
layout(set = 0, binding = 5) uniform sampler2D gi_emission;
layout(set = 0, binding = 20, std140) uniform GIFrame {
	GIFrameData data;
} gi_frame;
layout(set = 0, binding = 21, rgba16f) uniform writeonly image2D gi_reflection_output;
layout(set = 0, binding = 23) uniform sampler2D gi_dfg_lut;
layout(location = 0) rayPayloadEXT GIPathPayload gi_payload;

const uint GI_RAY_MODE_REFLECTION = 2u;
const uint GI_RAY_MODE_MISS = 4u;
const uint GI_MATERIAL_MODEL_MASK = 0x0fu;
const uint GI_UNLIT_MATERIAL_MODEL = 0u;
const float GI_PI = 3.14159265359;
const float GI_HALF_MAX = 65504.0;

uint gi_hash(uint value) {
	value ^= value >> 16u;
	value *= 0x7feb352du;
	value ^= value >> 15u;
	value *= 0x846ca68bu;
	value ^= value >> 16u;
	return value;
}

float gi_random(inout uint state) {
	state = gi_hash(state);
	return float(state) * (1.0 / 4294967296.0);
}

vec3 gi_finite_nonnegative(vec3 value) {
	return vec3(isnan(value.x) || isinf(value.x) ? 0.0 : max(value.x, 0.0),
			isnan(value.y) || isinf(value.y) ? 0.0 : max(value.y, 0.0),
			isnan(value.z) || isinf(value.z) ? 0.0 : max(value.z, 0.0));
}

ivec2 gi_uv_to_texel(vec2 uv, ivec2 size) {
	return clamp(ivec2(floor(uv * vec2(size))), ivec2(0), size - ivec2(1));
}

vec3 gi_sample_vndf(vec3 normal, vec3 view_direction, float roughness, vec2 xi) {
	vec3 helper = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
	vec3 tangent = normalize(cross(helper, normal));
	vec3 bitangent = cross(normal, tangent);
	vec3 view_local = vec3(dot(view_direction, tangent), dot(view_direction, bitangent), dot(view_direction, normal));
	float alpha = max(roughness * roughness, 1e-4);
	vec3 stretched = normalize(vec3(alpha * view_local.x, alpha * view_local.y, view_local.z));
	float lensq = stretched.x * stretched.x + stretched.y * stretched.y;
	vec3 t1 = lensq > 1e-8 ? vec3(-stretched.y, stretched.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
	vec3 t2 = cross(stretched, t1);
	float radius = sqrt(xi.x);
	float phi = 2.0 * GI_PI * xi.y;
	float p1 = radius * cos(phi);
	float p2 = radius * sin(phi);
	float blend = 0.5 * (1.0 + stretched.z);
	p2 = (1.0 - blend) * sqrt(max(1.0 - p1 * p1, 0.0)) + blend * p2;
	vec3 visible_normal = p1 * t1 + p2 * t2 + sqrt(max(1.0 - p1 * p1 - p2 * p2, 0.0)) * stretched;
	vec3 half_local = normalize(vec3(alpha * visible_normal.x, alpha * visible_normal.y, max(visible_normal.z, 0.0)));
	return normalize(tangent * half_local.x + bitangent * half_local.y + normal * half_local.z);
}

float gi_smith_g1(float no_x, float roughness) {
	float alpha = max(roughness * roughness, 1e-4);
	float alpha2 = alpha * alpha;
	return 2.0 * no_x / max(no_x + sqrt(alpha2 + (1.0 - alpha2) * no_x * no_x), 1e-6);
}

void store_invalid(ivec2 pixel) {
	imageStore(gi_reflection_output, pixel, vec4(0.0));
}

void main() {
	ivec2 output_size = imageSize(gi_reflection_output);
	ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
	if (any(greaterThanEqual(pixel, output_size))) {
		return;
	}
	vec2 uv = (vec2(pixel) + 0.5) / vec2(output_size);
	ivec2 depth_pixel = gi_uv_to_texel(uv, textureSize(gi_depth, 0));
	ivec2 normal_pixel = gi_uv_to_texel(uv, textureSize(gi_normal_roughness, 0));
	ivec2 albedo_pixel = gi_uv_to_texel(uv, textureSize(gi_albedo, 0));
	ivec2 orm_pixel = gi_uv_to_texel(uv, textureSize(gi_orm, 0));
	ivec2 emission_pixel = gi_uv_to_texel(uv, textureSize(gi_emission, 0));
	float depth = texelFetch(gi_depth, depth_pixel, 0).r;
	vec4 orm = texelFetch(gi_orm, orm_pixel, 0);
	uint material_model = uint(round(clamp(orm.a, 0.0, 1.0) * 255.0)) & GI_MATERIAL_MODEL_MASK;
	if (!(depth > 0.0) || isnan(depth) || isinf(depth) || material_model == GI_UNLIT_MATERIAL_MODEL) {
		store_invalid(pixel);
		return;
	}
	vec4 view_h = gi_frame.data.inverse_projection * vec4(uv * 2.0 - 1.0, depth, 1.0);
	if (abs(view_h.w) < 1e-8 || isnan(view_h.w) || isinf(view_h.w)) {
		store_invalid(pixel);
		return;
	}
	vec3 view_position = view_h.xyz / view_h.w;
	if (any(isnan(view_position)) || any(isinf(view_position))) {
		store_invalid(pixel);
		return;
	}
	vec3 world_position = (gi_frame.data.view_to_world * vec4(view_position, 1.0)).xyz;
	if (any(isnan(world_position)) || any(isinf(world_position))) {
		store_invalid(pixel);
		return;
	}
	vec3 normal_encoded = texelFetch(gi_normal_roughness, normal_pixel, 0).xyz * 2.0 - 1.0;
	float normal_length = length(normal_encoded);
	if (!(normal_length > 1e-6) || isnan(normal_length) || isinf(normal_length)) {
		store_invalid(pixel);
		return;
	}
	vec3 transformed_normal = mat3(gi_frame.data.view_to_world) * (normal_encoded / normal_length);
	float transformed_normal_length = length(transformed_normal);
	bool orthographic_camera = abs(gi_frame.data.inverse_projection[3][3] - 1.0) < 1e-4;
	vec3 view_vector = orthographic_camera
			? mat3(gi_frame.data.view_to_world) * vec3(0.0, 0.0, 1.0)
			: gi_frame.data.view_to_world[3].xyz - world_position;
	float view_length = length(view_vector);
	if (!(transformed_normal_length > 1e-6) || isnan(transformed_normal_length) || isinf(transformed_normal_length)
			|| !(view_length > 1e-6) || isnan(view_length) || isinf(view_length)
			|| any(isnan(view_vector)) || any(isinf(view_vector))) {
		store_invalid(pixel);
		return;
	}
	vec3 normal = transformed_normal / transformed_normal_length;
	vec3 view_direction = view_vector / view_length;
	float no_v = max(dot(normal, view_direction), 1e-4);
	float metallic = clamp(orm.b, 0.0, 1.0);
	float roughness = clamp(orm.g, 0.0, 1.0);
	float material_specular = clamp(texelFetch(gi_emission, emission_pixel, 0).a, 0.0, 1.0);
	vec3 albedo = max(texelFetch(gi_albedo, albedo_pixel, 0).rgb, vec3(0.0));
	vec3 f0 = mix(vec3(0.16 * material_specular * material_specular), albedo, metallic);
	float f90 = clamp(50.0 * f0.g, metallic, 1.0);
	vec2 env_brdf = textureLod(gi_dfg_lut, vec2(no_v, 1.0 - roughness), 0.0).rg;
	if (!(env_brdf.y > 1e-4) || isnan(env_brdf.y) || isinf(env_brdf.y)) {
		store_invalid(pixel);
		return;
	}
	vec3 energy_compensation = 1.0 + f0 * (1.0 / env_brdf.y - 1.0);
	float p0 = gi_frame.data.size_exposure.z;
	float scene_normalization = gi_frame.data.size_exposure.w;
	if (!(p0 > 0.0) || !(scene_normalization > 0.0) || isnan(p0) || isinf(p0)
			|| isnan(scene_normalization) || isinf(scene_normalization)) {
		store_invalid(pixel);
		return;
	}
	uint sample_count = uint(clamp(round(gi_frame.data.trace_parameters.z), 1.0, 4.0));
	if (sample_count != 1u && sample_count != 2u && sample_count != 4u) {
		sample_count = 1u;
	}
	uint seed = gi_hash(uint(pixel.x) * 0x9e3779b9u ^ uint(pixel.y) * 0x85ebca6bu
			^ gi_frame.data.sun_view_generation_sky_array.y ^ gi_frame.data.generation_history_flags.x);
	// Fixed per-pixel scrambling with a low-discrepancy temporal sequence.
	float rotation_x = gi_random(seed);
	float rotation_y = gi_random(seed);
	vec2 temporal_sample = fract(vec2(rotation_x, rotation_y)
			+ float(gi_frame.data.sun_view_generation_sky_array.z & 4095u) * vec2(0.754877666, 0.569840296));
	float max_distance = max(gi_frame.data.trace_parameters.x, 0.001);
	vec3 result = vec3(0.0);
	float hit_distance_sum = 0.0;
	uint hit_count = 0u;
	for (uint sample_index = 0u; sample_index < sample_count; sample_index++) {
		vec2 xi = vec2((float(sample_index) + temporal_sample.x) / float(sample_count),
				fract(temporal_sample.y + float(sample_index) * 0.618033989));
		vec3 half_vector = roughness <= 0.001 ? normal : gi_sample_vndf(normal, view_direction, roughness, xi);
		float vo_h = max(dot(view_direction, half_vector), 0.0);
		vec3 reflected = reflect(-view_direction, half_vector);
		float direction_length = length(reflected);
		if (!(direction_length > 1e-6) || isnan(direction_length) || isinf(direction_length)
				|| any(isnan(reflected)) || any(isinf(reflected))) {
			continue;
		}
		vec3 direction = reflected / direction_length;
		float no_l = dot(normal, direction);
		if (no_l <= 0.0) {
			continue;
		}
		vec3 fresnel = f0 + (vec3(f90) - f0) * pow(clamp(1.0 - vo_h, 0.0, 1.0), 5.0);
		float visibility = gi_smith_g1(max(no_l, 1e-4), roughness);
		gi_payload.radiance = vec3(0.0);
		gi_payload.flags = GI_RAY_MODE_REFLECTION;
		gi_payload.hit_distance = 0.0;
		traceRayEXT(gi_scene_tlas, gl_RayFlagsNoneEXT, 0x01u, 0u, 0u, 0u,
				world_position + normal * 0.001, 0.001, direction, max_distance, 0);
		result += gi_finite_nonnegative(gi_payload.radiance) * fresnel * visibility * energy_compensation;
		if (gi_payload.flags != GI_RAY_MODE_MISS) {
			hit_count++;
			hit_distance_sum += max(gi_payload.hit_distance, 0.0);
		}
	}
	result = min(gi_finite_nonnegative(result / float(sample_count)) * p0 * scene_normalization, vec3(GI_HALF_MAX));
	float hit_data = hit_count * 2u >= sample_count ? max(hit_distance_sum / max(float(hit_count), 1.0), 0.001) : -max_distance;
	imageStore(gi_reflection_output, pixel, vec4(result, hit_data));
}
