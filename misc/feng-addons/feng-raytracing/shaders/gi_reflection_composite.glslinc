#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D scene_color_or_separate_specular;
layout(set = 0, binding = 1) uniform sampler2D native_indirect_specular;
layout(set = 0, binding = 2) uniform sampler2D traced_reflection;
layout(set = 0, binding = 3, std140) uniform ReflectionTemporal {
	vec4 parameters; // history weight, exposure ratio, depth rejection threshold, normal threshold.
	vec4 thresholds; // roughness, hit-distance, metallic and specular rejection thresholds.
	uvec4 state; // valid history, generation low, generation high, replacement-strength bits.
} temporal;

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(scene_color_or_separate_specular);
	if (any(greaterThanEqual(pixel, size))) {
		return;
	}
	ivec2 native_pixel = clamp(pixel, ivec2(0), textureSize(native_indirect_specular, 0) - ivec2(1));
	ivec2 traced_pixel = clamp(pixel, ivec2(0), textureSize(traced_reflection, 0) - ivec2(1));
	vec4 traced = texelFetch(traced_reflection, traced_pixel, 0);
	bool traced_valid = !any(isnan(traced.rgb)) && !any(isinf(traced.rgb))
			&& all(greaterThanEqual(traced.rgb, vec3(0.0))) && traced.a >= 0.5 && !isnan(traced.a) && !isinf(traced.a);
	float requested_replacement = uintBitsToFloat(temporal.state.w);
	if (!traced_valid || isnan(requested_replacement) || isinf(requested_replacement)) {
		return;
	}
	float replacement = clamp(requested_replacement, 0.0, 1.0);
	if (replacement <= 0.0) {
		return;
	}
	vec4 scene = imageLoad(scene_color_or_separate_specular, pixel);
	vec4 captured = texelFetch(native_indirect_specular, native_pixel, 0);
	if (any(isnan(scene.rgb)) || any(isinf(scene.rgb)) || any(isnan(captured.rgb)) || any(isinf(captured.rgb))) {
		return;
	}
	vec3 result = scene.rgb - captured.rgb * replacement + traced.rgb * replacement;
	if (any(isnan(result)) || any(isinf(result))) {
		return;
	}
	imageStore(scene_color_or_separate_specular,
			pixel, vec4(clamp(result, vec3(0.0), vec3(65504.0)), scene.a));
}
