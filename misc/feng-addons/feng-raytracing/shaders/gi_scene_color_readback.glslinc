#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(set=0, binding=0) uniform sampler2D scene_color_source;
layout(set=0, binding=1, rgba16f) writeonly uniform image2D scene_color_copy;

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(scene_color_copy);
	if (any(greaterThanEqual(pixel, size))) {
		return;
	}
	imageStore(scene_color_copy, pixel, texelFetch(scene_color_source, pixel, 0));
}
