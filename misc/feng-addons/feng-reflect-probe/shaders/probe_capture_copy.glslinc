#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D scene_hdr;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2DArray captured_faces;
layout(set = 0, binding = 2, std140) uniform CaptureParameters {
	ivec4 face_size_index;
	vec4 exposure;
} params;

bool finite_rgb(vec3 value) { return !any(isnan(value)) && !any(isinf(value)); }

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = params.face_size_index.xy;
	int face = params.face_size_index.z;
	if (any(greaterThanEqual(pixel, size)) || face < 0 || face >= 6) return;
	vec2 source_uv = (vec2(pixel) + 0.5) / vec2(size);
	vec4 value = textureLod(scene_hdr, source_uv, 0.0);
	float exposure = params.exposure.x;
	if (!finite_rgb(value.rgb) || isnan(exposure) || isinf(exposure) || exposure <= 1e-8) {
		value = vec4(0.0);
	} else {
		float half_max_preexposed = 65504.0 * exposure;
		if (isinf(half_max_preexposed)) half_max_preexposed = 3.402823e38;
		value.rgb = clamp(value.rgb, vec3(0.0), vec3(half_max_preexposed)) / exposure;
		value.rgb = clamp(value.rgb, vec3(0.0), vec3(65504.0));
		value.a = 1.0;
	}
	imageStore(captured_faces, ivec3(pixel, face), value);
}
