#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2DArray captured_faces;
layout(rgba16f, set = 0, binding = 1) uniform writeonly imageCube raw_cube;
layout(set = 0, binding = 2, std140) uniform ConvertParameters {
	ivec4 face_size_index;
} params;

vec3 cube_direction(int face, vec2 st) {
	float s = st.x * 2.0 - 1.0;
	float t = st.y * 2.0 - 1.0;
	if (face == 0) return normalize(vec3(1.0, -t, -s));
	if (face == 1) return normalize(vec3(-1.0, -t, s));
	if (face == 2) return normalize(vec3(s, 1.0, t));
	if (face == 3) return normalize(vec3(s, -1.0, -t));
	if (face == 4) return normalize(vec3(s, -t, 1.0));
	return normalize(vec3(-s, -t, -1.0));
}

vec3 camera_forward(int face) {
	if (face == 0) return vec3(1, 0, 0);
	if (face == 1) return vec3(-1, 0, 0);
	if (face == 2) return vec3(0, 1, 0);
	if (face == 3) return vec3(0, -1, 0);
	if (face == 4) return vec3(0, 0, 1);
	return vec3(0, 0, -1);
}

vec3 camera_up(int face) {
	if (face == 2) return vec3(0, 0, -1);
	if (face == 3) return vec3(0, 0, 1);
	if (face == 0 || face == 1 || face == 4 || face == 5) return vec3(0, -1, 0);
	return vec3(0, 1, 0);
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = params.face_size_index.xy;
	int output_face = int(gl_GlobalInvocationID.z);
	if (any(greaterThanEqual(pixel, size)) || output_face < 0 || output_face >= 6) return;
	vec2 st = (vec2(pixel) + 0.5) / vec2(size);
	vec3 direction = cube_direction(output_face, st);
	int capture_face = 0;
	float best_dot = -2.0;
	for (int face = 0; face < 6; face++) {
		float facing = dot(direction, camera_forward(face));
		if (facing > best_dot) { best_dot = facing; capture_face = face; }
	}
	vec3 forward = camera_forward(capture_face);
	vec3 up = camera_up(capture_face);
	vec3 right = normalize(cross(forward, up));
	float divisor = max(dot(direction, forward), 1e-6);
	vec2 capture_uv = vec2(0.5 + 0.5 * dot(direction, right) / divisor,
			0.5 - 0.5 * dot(direction, up) / divisor);
	capture_uv = clamp(capture_uv, vec2(0.0), vec2(1.0));
	vec4 value = textureLod(captured_faces, vec3(capture_uv, float(capture_face)), 0.0);
	imageStore(raw_cube, ivec3(pixel, output_face), value);
}
