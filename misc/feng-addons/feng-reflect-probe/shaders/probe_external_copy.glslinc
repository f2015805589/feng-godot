#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube external_radiance;
layout(rgba16f, set = 0, binding = 1) uniform writeonly imageCube raw_radiance;

vec3 cube_direction(int face, vec2 st) {
	float s = st.x * 2.0 - 1.0;
	float t = st.y * 2.0 - 1.0;
	if (face == 0) return normalize(vec3(1.0, -t, -s));
	if (face == 1) return normalize(vec3(-1.0, -t, s));
	if (face == 2) return normalize(vec3(s, 1.0, t));
	if (face == 3) return normalize(vec3(s, -1.0, -t));
	if (face == 4) return normalize(vec3(s, -t, 1.0));
	return normalize(vec3(-s, -t, -1.0));
}

bool finite_rgb(vec3 value) { return !any(isnan(value)) && !any(isinf(value)); }

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	int face = int(gl_GlobalInvocationID.z);
	ivec2 size = imageSize(raw_radiance);
	if (any(greaterThanEqual(pixel, size)) || face < 0 || face >= 6) return;
	vec3 direction = cube_direction(face, (vec2(pixel) + 0.5) / vec2(size));
	vec3 value = textureLod(external_radiance, direction, 0.0).rgb;
	if (!finite_rgb(value)) value = vec3(0.0);
	imageStore(raw_radiance, ivec3(pixel, face), vec4(clamp(value, vec3(0.0), vec3(65504.0)), 1.0));
}
