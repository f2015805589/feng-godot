#[compute]
#version 450

#include "volumetric_fog_frame.glslinc"
#include "volumetric_fog_history.glslinc"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(set = 0, binding = 1) uniform sampler3D current_scattering_extinction;
layout(set = 0, binding = 2) uniform sampler3D previous_scattering_extinction;
layout(rgba16f, set = 0, binding = 3) uniform image3D history_output;
layout(set = 0, binding = 4) uniform sampler2D current_conservative_depth;
layout(set = 0, binding = 5) uniform sampler2D previous_conservative_depth;

void main() {
	uvec3 cell = gl_GlobalInvocationID;
	ivec3 grid = ivec3(fog_frame.grid_view.xyz);
	if (any(greaterThanEqual(ivec3(cell), grid))) {
		return;
	}
	int view_index = int(fog_frame.grid_view.w);
	int atlas_width = textureSize(current_scattering_extinction, 0).x;
	ivec3 atlas_cell = ivec3(view_index * grid.x + int(cell.x), int(cell.y), int(cell.z));
	vec4 current = texelFetch(current_scattering_extinction, atlas_cell, 0);
	vec4 resolved = current;
	float pixel_size = max(fog_frame.history_control.w, 1.0);
	vec2 internal_size = max(fog_frame.history_frame_size.zw, vec2(1.0));
	vec2 current_screen_uv = (vec2(cell.xy) + vec2(0.5)) * pixel_size / internal_size;
	float current_froxel_depth = feng_fog_depth_from_slice(float(cell.z) + 0.5);
	vec3 current_view_position = feng_fog_view_position(current_screen_uv, current_froxel_depth);
	vec3 conservative_view_position = feng_fog_view_position(current_screen_uv,
			feng_fog_depth_from_slice(max(float(cell.z) - 0.5, 0.0)));
	bool current_occluded = feng_volume_current_cell_occluded(conservative_view_position,
			ivec2(cell.xy), grid, view_index, current_conservative_depth);
	if (fog_frame.history_control.y > 0.5 && fog_frame.history_control.x > 0.0
			&& !current_occluded) {
		float previous_slice = 0.0;
		float previous_view_depth = 0.0;
		bool has_valid_history = false;
		vec2 previous_grid_uv = feng_volume_previous_grid_uv(current_view_position,
				conservative_view_position, grid, view_index, previous_conservative_depth, previous_slice,
				previous_view_depth, has_valid_history);
		if (has_valid_history) {
			float previous_z = clamp(previous_slice / float(max(grid.z, 1)),
					0.5 / float(max(grid.z, 1)), 1.0 - 0.5 / float(max(grid.z, 1)));
			vec2 previous_cell_uv = previous_grid_uv * vec2(grid.xy);
			vec3 previous_atlas_uv = vec3(
					(float(view_index * grid.x) + previous_cell_uv.x) / float(max(atlas_width, 1)),
					previous_cell_uv.y / float(max(grid.y, 1)), previous_z);
			vec4 history = texture(previous_scattering_extinction, previous_atlas_uv);
			float current_storage_normalization = fog_frame.distance_exposure.w
					* max(fog_frame.history_control.z, 1.0e-8);
			float exposure_ratio = current_storage_normalization
					/ max(fog_frame.history_frame_size.x, 1.0e-8);
			history.rgb *= exposure_ratio;
			if (!any(isnan(history)) && !any(isinf(history))) {
				history.rgb = clamp(history.rgb, vec3(0.0), vec3(FENG_FOG_HALF_MAX));
				resolved = mix(current, history, clamp(fog_frame.history_control.x, 0.0, 0.99));
			}
		}
	}
	imageStore(history_output, atlas_cell, vec4(clamp(resolved.rgb, vec3(0.0),
			vec3(FENG_FOG_HALF_MAX)), feng_fog_finite_nonnegative(resolved.a)));
}
