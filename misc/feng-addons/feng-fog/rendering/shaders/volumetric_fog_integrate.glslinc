#[compute]
#version 450

#include "volumetric_fog_frame.glslinc"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 1) uniform sampler3D scattering_extinction;
layout(rgba16f, set = 0, binding = 2) uniform image3D integrated_output;

void main() {
	uvec2 cell_xy = gl_GlobalInvocationID.xy;
	ivec2 grid_xy = ivec2(fog_frame.grid_view.xy);
	if (any(greaterThanEqual(ivec2(cell_xy), grid_xy))) {
		return;
	}
	ivec3 grid = ivec3(fog_frame.grid_view.xyz);
	int view_index = int(fog_frame.grid_view.w);
	int atlas_x = view_index * grid.x + int(cell_xy.x);
	float pixel_size = max(fog_frame.history_control.w, 1.0);
	vec2 internal_size = max(fog_frame.history_frame_size.zw, vec2(1.0));
	vec2 uv = (vec2(cell_xy) + vec2(0.5)) * pixel_size / internal_size;
	// UE integrates the fixed-center ray from the volume near plane to each
	// slice center. Halton offsets belong to light injection only.
	vec3 previous_position = feng_fog_world_position(uv, feng_fog_depth_from_slice(0.0));
	vec3 accumulated_radiance = vec3(0.0);
	float accumulated_transmittance = 1.0;
	float accumulated_depth = 0.0;
	for (int z = 0; z < grid.z; ++z) {
		ivec3 source_coord = ivec3(atlas_x, int(cell_xy.y), z);
		vec4 medium = texelFetch(scattering_extinction, source_coord, 0);
		float center_depth = feng_fog_depth_from_slice(float(z) + 0.5);
		vec3 center_position = feng_fog_world_position(uv, center_depth);
		float step_length = length(center_position - previous_position);
		previous_position = center_position;
		if (isnan(step_length) || isinf(step_length)) {
			step_length = 0.0;
		}
		float extinction = feng_fog_finite_nonnegative(medium.a);
		float slice_transmittance = exp(clamp(-extinction * step_length, -80.0, 0.0));
		accumulated_depth += step_length;
		float near_fade = fog_frame.distance_exposure.z > 0.0
				? clamp(accumulated_depth / fog_frame.distance_exposure.z, 0.0, 1.0) : 1.0;
		float integrated_weight = extinction > 1.0e-5
				? (1.0 - slice_transmittance) / extinction : step_length;
		accumulated_radiance += clamp(medium.rgb, vec3(0.0), vec3(FENG_FOG_HALF_MAX))
				* integrated_weight * accumulated_transmittance * near_fade;
		accumulated_transmittance *= mix(1.0, slice_transmittance, near_fade);
		imageStore(integrated_output, ivec3(atlas_x, int(cell_xy.y), z),
				vec4(clamp(accumulated_radiance, vec3(0.0), vec3(FENG_FOG_HALF_MAX)),
					clamp(accumulated_transmittance, 0.0, 1.0)));
	}
}
