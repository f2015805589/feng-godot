#[compute]
#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D source_mip;
layout(rgba16f, set = 0, binding = 1) uniform image2D filtered_mip;

// UE 5.8's FogSeparateComposition.usf 5x5 kernel, collapsed with its
// GetSampleCoordAndWeight() weighted-centroid grouping into nine bilinear
// reads. Weights are deliberately kept at UE's authored precision.
const vec2 FSSS_SAMPLE_OFFSETS[9] = vec2[9](
	vec2(-1.1999563, -1.1999563), vec2(0.3773760, -1.2075413), vec2(2.0, -1.1998908),
	vec2(-1.2075413, 0.3773760), vec2(0.3853225, 0.3853225), vec2(2.0, 0.3636138),
	vec2(-1.1998908, 2.0), vec2(0.3636138, 2.0), vec2(2.0, 2.0));
const float FSSS_SAMPLE_WEIGHTS[9] = float[9](
	0.09157, 0.19413, 0.01831,
	0.19413, 0.39925, 0.04029,
	0.01831, 0.04029, 0.00366);
const float MAX_EXPOSED_LUMINANCE = 10.0;

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 extent = imageSize(filtered_mip);
	if (any(greaterThanEqual(pixel, extent))) {
		return;
	}
	vec2 center_uv = (vec2(pixel) + vec2(0.5)) / vec2(extent);
	vec2 texel = 1.0 / vec2(extent);
	const float gaussian_blur_scale = 1.0;
	vec3 accumulator = vec3(0.0);
	for (int index = 0; index < 9; ++index) {
		vec2 uv = center_uv + FSSS_SAMPLE_OFFSETS[index] * gaussian_blur_scale * texel;
		vec3 sample_rgb = min(textureLod(source_mip, uv, 0.0).rgb,
				vec3(MAX_EXPOSED_LUMINANCE));
		accumulator += sample_rgb * FSSS_SAMPLE_WEIGHTS[index];
	}
	float final_transmittance = texelFetch(source_mip, pixel, 0).a;
	imageStore(filtered_mip, pixel, vec4(accumulator, final_transmittance));
}
