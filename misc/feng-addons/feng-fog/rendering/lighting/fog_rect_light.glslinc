#ifndef FENG_FOG_RECT_LIGHT_GLSLINC
#define FENG_FOG_RECT_LIGHT_GLSLINC

// UE5.8 RectLightIntegrate + RectLight source-texture math for FRP's
// LightStorage::LightData. `area_width` and `area_height` are full-span
// view-space vectors; `to_light` points from the froxel to the light center.
// Add the frame packet's eye_offset to a per-eye froxel position before using
// this helper because the published light vectors are in center-camera view.

const float FFogRectMinEdgeDenominator = 1e-4;
const float FFogRectMinLengthSquared = 1e-4;
const float FFogRectBarnDoorCosThreshold = 0.035;
const float FFogRectFrameAlignmentEpsilon = 0.001;

struct FFogRectVisibleRect {
	vec3 to_light;
	vec3 area_width;
	vec3 area_height;
	vec2 half_extent;
	vec2 offset;
	vec3 light_space_receiver;
	bool valid;
	bool clipped;
};

bool ffog_rect_is_finite(vec3 value) {
	return !any(isnan(value)) && !any(isinf(value));
}

FFogRectVisibleRect ffog_rect_invalid_visible_rect() {
	FFogRectVisibleRect result;
	result.to_light = vec3(0.0);
	result.area_width = vec3(0.0);
	result.area_height = vec3(0.0);
	result.half_extent = vec2(0.0);
	result.offset = vec2(0.0);
	result.light_space_receiver = vec3(0.0);
	result.valid = false;
	result.clipped = false;
	return result;
}

// Literal geometry contract from UE RectLight.ush::GetRect (602-687).
// All vectors are in the same center-view meter space. `to_light` is the
// original light center minus receiver; native area vectors are full spans.
// Only integrate the returned visible vectors. Keep the original center and
// spans for HG phase and source-texture UV lookup.
FFogRectVisibleRect ffog_rect_visible_rect(vec3 to_light, vec3 area_width_full_span,
		vec3 area_height_full_span, vec3 native_light_forward,
		float barn_cos_angle, float barn_length_m, bool barn_enabled) {
	FFogRectVisibleRect result = ffog_rect_invalid_visible_rect();
	if (!ffog_rect_is_finite(to_light) || !ffog_rect_is_finite(area_width_full_span) ||
			!ffog_rect_is_finite(area_height_full_span) ||
			!ffog_rect_is_finite(native_light_forward) ||
			isnan(barn_cos_angle) || isinf(barn_cos_angle) ||
			isnan(barn_length_m) || isinf(barn_length_m)) {
		return result;
	}
	float width_length_squared = dot(area_width_full_span, area_width_full_span);
	float height_length_squared = dot(area_height_full_span, area_height_full_span);
	float forward_length_squared = dot(native_light_forward, native_light_forward);
	float to_light_length_squared = dot(to_light, to_light);
	if (isnan(width_length_squared) || isinf(width_length_squared) ||
			isnan(height_length_squared) || isinf(height_length_squared) ||
			isnan(forward_length_squared) || isinf(forward_length_squared) ||
			isnan(to_light_length_squared) || isinf(to_light_length_squared) ||
			width_length_squared <= FFogRectMinLengthSquared ||
		height_length_squared <= FFogRectMinLengthSquared ||
		forward_length_squared <= FFogRectMinLengthSquared ||
		to_light_length_squared <= 1e-8 || barn_cos_angle < 0.0 ||
		barn_cos_angle > 1.0 || barn_length_m < 0.0) {
		return result;
	}
	float width_length = sqrt(width_length_squared);
	float height_length = sqrt(height_length_squared);
	vec3 width_axis = area_width_full_span / width_length;
	vec3 height_axis = area_height_full_span / height_length;
	vec3 light_forward = native_light_forward * inversesqrt(forward_length_squared);
	// UE axis 1 is the tangent and axis 2 is its light-data direction. Godot's
	// published forward is local -Z, so UE axis 2 is -native_light_forward.
	vec3 axis_1 = height_axis;
	vec3 axis_2 = -light_forward;
	vec3 axis_0_raw = cross(axis_1, axis_2);
	float axis_0_length_squared = dot(axis_0_raw, axis_0_raw);
	if (isnan(axis_0_length_squared) || isinf(axis_0_length_squared) ||
			axis_0_length_squared <= FFogRectMinLengthSquared) {
		return result;
	}
	vec3 axis_0 = axis_0_raw * inversesqrt(axis_0_length_squared);
	if (dot(width_axis, axis_0) < 1.0 - FFogRectFrameAlignmentEpsilon ||
			abs(dot(width_axis, height_axis)) > FFogRectFrameAlignmentEpsilon ||
			abs(dot(width_axis, light_forward)) > FFogRectFrameAlignmentEpsilon ||
			abs(dot(height_axis, light_forward)) > FFogRectFrameAlignmentEpsilon) {
		return result;
	}
	vec2 light_extent = vec2(width_length, height_length) * 0.5;
	vec3 light_space = vec3(dot(axis_0, to_light), dot(axis_1, to_light),
			dot(axis_2, to_light));
	result.to_light = to_light;
	result.area_width = area_width_full_span;
	result.area_height = area_height_full_span;
	result.half_extent = light_extent;
	result.offset = vec2(0.0);
	result.light_space_receiver = light_space;
	result.valid = true;
	if (!barn_enabled || barn_cos_angle <= FFogRectBarnDoorCosThreshold || barn_length_m <= 0.0) {
		return result;
	}
	if (!ffog_rect_is_finite(light_space) || light_space.z <= 0.0) {
		return ffog_rect_invalid_visible_rect();
	}

	// UE RectLight.ush:652-685, including its sign(0)==0 behavior and clamps.
	float sin_theta = sqrt(max(1.0 - barn_cos_angle * barn_cos_angle, 0.0));
	float barn_depth = min(light_space.z, barn_cos_angle * barn_length_m);
	float sample_ratio = barn_depth / max(0.0001, barn_cos_angle * barn_length_m);
	float door_projection = sin_theta * barn_length_m * sample_ratio;
	vec2 sign_sample = sign(light_space.xy);
	vec2 projected_sample = sign_sample * max(abs(light_space.xy), light_extent + vec2(door_projection));
	vec3 closest_corner = vec3(sign_sample * (light_extent + vec2(door_projection)), barn_depth);
	vec3 sample_projection = vec3(projected_sample, light_space.z);
	vec3 s_projected = sample_projection - closest_corner;
	float cos_eta = max(s_projected.z, 0.001);
	vec2 tan_eta = abs(s_projected.xy) / cos_eta;
	vec2 projected_door_distance = vec2(barn_depth) * tan_eta;
	vec2 delta = projected_door_distance - vec2(door_projection);
	vec2 minimum_xy = clamp(-light_extent + delta * max(vec2(0.0), -sign_sample),
			-light_extent, light_extent);
	vec2 maximum_xy = clamp(light_extent - delta * max(vec2(0.0), sign_sample),
			-light_extent, light_extent);
	vec2 rect_offset = 0.5 * (minimum_xy + maximum_xy);
	vec2 visible_half_extent = 0.5 * (maximum_xy - minimum_xy);
	if (any(isnan(rect_offset)) || any(isinf(rect_offset)) ||
			any(isnan(visible_half_extent)) || any(isinf(visible_half_extent)) ||
			visible_half_extent.x <= 0.0 || visible_half_extent.y <= 0.0) {
		return ffog_rect_invalid_visible_rect();
	}
	vec3 shifted_to_light = to_light - axis_0 * rect_offset.x - axis_1 * rect_offset.y;
	vec3 visible_width = axis_0 * (2.0 * visible_half_extent.x);
	vec3 visible_height = axis_1 * (2.0 * visible_half_extent.y);
	if (!ffog_rect_is_finite(shifted_to_light) || !ffog_rect_is_finite(visible_width) ||
			!ffog_rect_is_finite(visible_height)) {
		return ffog_rect_invalid_visible_rect();
	}
	result.to_light = shifted_to_light;
	result.area_width = visible_width;
	result.area_height = visible_height;
	result.half_extent = visible_half_extent;
	result.offset = rect_offset;
	result.clipped = dot(rect_offset, rect_offset) > 1e-8 ||
			distance(visible_half_extent, light_extent) > 1e-4;
	return result;
}

struct FFogRectIntegral {
	float falloff;
	vec3 integrated_direction;
	bool valid;
};

float ffog_rect_edge_weight(float cosine) {
	float c = clamp(cosine, -1.0, 1.0);
	return (1.5708 - 0.175 * c) * inversesqrt(max(c + 1.0, FFogRectMinEdgeDenominator));
}

// Mirrors RectIrradianceLambert's active spherical polygon approximation.
// Falloff is already the angular solid-angle integral; do not multiply by an
// additional inverse-square factor. This is the scalar used by UE's fog
// IntegrateLight(Rect); the volumetric phase direction remains normalize(to_light).
FFogRectIntegral ffog_rect_integrate(vec3 to_light, vec3 area_width, vec3 area_height) {
	FFogRectIntegral result;
	result.falloff = 0.0;
	result.integrated_direction = vec3(0.0, 0.0, 0.0);
	result.valid = false;
	float width_length = length(area_width);
	float height_length = length(area_height);
	if (width_length * width_length <= FFogRectMinLengthSquared ||
			height_length * height_length <= FFogRectMinLengthSquared ||
			dot(to_light, to_light) <= FFogRectMinLengthSquared) {
		return result;
	}
	vec3 width_axis = area_width / width_length;
	vec3 height_axis = area_height / height_length;
	vec3 half_width = area_width * 0.5;
	vec3 half_height = area_height * 0.5;
	vec3 corners[4];
	corners[0] = normalize(to_light - half_width - half_height);
	corners[1] = normalize(to_light + half_width - half_height);
	corners[2] = normalize(to_light + half_width + half_height);
	corners[3] = normalize(to_light - half_width + half_height);
	float w01 = ffog_rect_edge_weight(dot(corners[0], corners[1]));
	float w12 = ffog_rect_edge_weight(dot(corners[1], corners[2]));
	float w23 = ffog_rect_edge_weight(dot(corners[2], corners[3]));
	float w30 = ffog_rect_edge_weight(dot(corners[3], corners[0]));
	vec3 spherical_integral = cross(corners[1], -w01 * corners[0] + w12 * corners[2]) +
			cross(corners[3], w30 * corners[0] - w23 * corners[2]);
	result.falloff = 0.5 * length(spherical_integral);
	if (dot(spherical_integral, spherical_integral) > FFogRectMinLengthSquared) {
		result.integrated_direction = normalize(spherical_integral);
	}
	result.valid = true;
	return result;
}

// UE's local-light range mask; the rect integral above already handles its
// angular distance falloff. `distance_squared` is from light center to froxel.
float ffog_rect_radius_mask(float distance_squared, float inv_radius) {
	float normalized_distance_squared = max(distance_squared, 0.0) * inv_radius * inv_radius;
	float radius = clamp(1.0 - normalized_distance_squared * normalized_distance_squared, 0.0, 1.0);
	return radius * radius;
}

// Returns (front-facing mask, UE volumetric soft fade). ToLightFromLight is
// light-center to froxel; fade distance is `cell_radius * light_soft_fading`.
vec2 ffog_rect_front_and_soft_fade(vec3 light_forward, vec3 to_receiver,
		float cell_radius, float light_soft_fading, bool enable_soft_fade) {
	float front_distance = dot(normalize(light_forward), to_receiver);
	float front_mask = front_distance >= 0.0 ? 1.0 : 0.0;
	float fade_distance = max(cell_radius, 0.0) * max(light_soft_fading, 0.0);
	float soft_fade = (enable_soft_fade && fade_distance > 0.0) ?
			clamp(front_distance / fade_distance, 0.0, 1.0) : 1.0;
	return vec2(front_mask, soft_fade);
}

// UE's RectLight source-texture lookup. `sample_to_light` is UE's center L
// vector used by VolumetricFog::SampleSourceTexture, not the polygon integral.
// `projector_rect` is the AreaLight3D source region in the packed area atlas;
// `atlas_max_mip` is LightData.cos_spot_angle for area lights. A false return
// means no area texture is bound; use a white multiplier in that case.
bool ffog_rect_source_texture_uv(vec3 sample_to_light, vec3 to_light,
		vec3 area_width, vec3 area_height, vec3 light_forward,
		vec4 projector_rect, vec2 atlas_size, float atlas_max_mip,
		out vec3 atlas_uv_mip) {
	atlas_uv_mip = vec3(0.5, 0.5, 0.0);
	if (projector_rect.z <= 0.0 || projector_rect.w <= 0.0 ||
			atlas_size.x <= 0.0 || atlas_size.y <= 0.0) {
		return false;
	}
	float denom = dot(sample_to_light, light_forward);
	if (abs(denom) <= 1e-4) {
		return false;
	}
	float distance_to_plane = dot(to_light, light_forward) / denom;
	if (distance_to_plane <= 0.0) {
		return false;
	}
	vec3 point_in_rect = sample_to_light * distance_to_plane - to_light;
	// UE Rect.FullExtent is the rectangle half extent. Native area_width and
	// area_height are full-span vectors, so convert to the same half extent.
	vec2 half_extent = max(vec2(length(area_width), length(area_height)) * 0.5, vec2(1e-4));
	vec2 local_position = vec2(dot(point_in_rect, normalize(area_width)),
			dot(point_in_rect, normalize(area_height)));
	vec2 local_uv = (local_position / half_extent) * vec2(0.5, -0.5) + 0.5;
	vec2 rect_pixels = projector_rect.zw * atlas_size;
	float min_rect_pixels = max(min(rect_pixels.x, rect_pixels.y), 1.0);
	float lod = log2(max(distance_to_plane * inversesqrt(max(half_extent.x * half_extent.y, 1e-4)), 1e-6)) +
			log2(min_rect_pixels) - 2.0;
	float max_mip = max(atlas_max_mip, 0.0);
	lod = clamp(min(lod, max_mip), 0.0, max_mip);
	vec2 half_texel = exp2(ceil(lod)) * 0.5 / atlas_size;
	vec2 uv_min = projector_rect.xy + half_texel;
	vec2 uv_max = projector_rect.xy + projector_rect.zw - half_texel;
	if (uv_min.x >= uv_max.x || uv_min.y >= uv_max.y) {
		return false;
	}
	vec2 atlas_uv = projector_rect.xy + local_uv * projector_rect.zw;
	atlas_uv_mip = vec3(clamp(atlas_uv, uv_min, uv_max), lod);
	return true;
}

vec4 ffog_rect_sample_source_texture(sampler2D area_atlas, vec3 atlas_uv_mip) {
	return textureLod(area_atlas, atlas_uv_mip.xy, atlas_uv_mip.z);
}

#endif // FENG_FOG_RECT_LIGHT_GLSLINC
