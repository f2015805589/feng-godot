#ifndef FENG_FOG_VOLUMETRIC_LIGHTMAP_SAMPLING_GLSLINC
#define FENG_FOG_VOLUMETRIC_LIGHTMAP_SAMPLING_GLSLINC

// FFogVolumetricLightmapProvider ABI v1. Set 5, bindings 0..10.
// Textures and UBO are provider-owned and borrowed by the consuming shader.
layout(set = 5, binding = 0, std140) uniform FFogVolumetricLightmapParams {
	mat4 ffog_vlm_world_to_capture;
	mat4 ffog_vlm_world_direction_to_capture;
	vec4 ffog_vlm_bounds_min;
	vec4 ffog_vlm_bounds_size;
	uvec4 ffog_vlm_indirection_dims_brick_size;
	uvec4 ffog_vlm_atlas_dims_source_flags;
	vec4 ffog_vlm_baked_metadata;
} ffog_vlm_params;
layout(set = 5, binding = 1) uniform usampler3D ffog_vlm_indirection;
layout(set = 5, binding = 2) uniform sampler3D ffog_vlm_ambient;
layout(set = 5, binding = 3) uniform sampler3D ffog_vlm_sh0;
layout(set = 5, binding = 4) uniform sampler3D ffog_vlm_sh1;
layout(set = 5, binding = 5) uniform sampler3D ffog_vlm_sh2;
layout(set = 5, binding = 6) uniform sampler3D ffog_vlm_sh3;
layout(set = 5, binding = 7) uniform sampler3D ffog_vlm_sh4;
layout(set = 5, binding = 8) uniform sampler3D ffog_vlm_sh5;
layout(set = 5, binding = 9) uniform sampler3D ffog_vlm_sky_bent_normal;
layout(set = 5, binding = 10) uniform sampler3D ffog_vlm_directional_shadow;

const uint FFOG_VLM_FLAG_VALID = 1u;
const uint FFOG_VLM_FLAG_INCLUDES_ENVIRONMENT_RADIANCE = 2u;
const uint FFOG_VLM_FLAG_CONTAINS_STATIC_DIRECT_DIRECTIONAL_LIGHTING = 4u;
const uint FFOG_VLM_FLAG_HAS_DIRECTIONAL_SHADOW = 8u;
const uint FFOG_VLM_FLAG_STATIC_LIGHT_KEY_MATCH = 16u;
const uint FFOG_VLM_FLAG_HAS_SKY_BENT_NORMAL = 32u;
const float FFOG_VLM_PI = 3.14159265358979323846;
const vec4 FFOG_VLM_SH2_L1_SCALE = vec4(
	0.488603 / 0.282095,
	0.488603 / 0.282095,
	0.488603 / 0.282095,
	1.092548 / 0.282095);

struct FFogVolumetricLightmapSample {
	bool valid;
	vec3 irradiance_over_pi;
	float sky_visibility;
	float directional_shadow;
	float baked_exposure;
	uint source_flags;
};

bool ffog_vlm_is_finite(float p_value) {
	return !isnan(p_value) && !isinf(p_value);
}

bool ffog_vlm_is_finite_vec3(vec3 p_value) {
	return ffog_vlm_is_finite(p_value.x) && ffog_vlm_is_finite(p_value.y) &&
		ffog_vlm_is_finite(p_value.z);
}

FFogVolumetricLightmapSample ffog_vlm_invalid_sample() {
	return FFogVolumetricLightmapSample(false, vec3(0.0), 1.0, 1.0,
		ffog_vlm_params.ffog_vlm_baked_metadata.x, 0u);
}

// `p_world_camera_vector` is UE's CameraVector/worldViewRay: camera -> froxel.
// UE 5.8 VolumetricFog uses SH2 and RotatedHGZonalHarmonic with the exact
// component order (1, dir.y, dir.z, dir.x) * (1, g, g, g).
FFogVolumetricLightmapSample ffog_sample_volumetric_lightmap(
		vec3 p_world_position, vec3 p_world_camera_vector, float p_g) {
	FFogVolumetricLightmapSample invalid_sample = ffog_vlm_invalid_sample();
	uint flags = ffog_vlm_params.ffog_vlm_atlas_dims_source_flags.w;
	if ((flags & FFOG_VLM_FLAG_VALID) == 0u ||
			any(equal(ffog_vlm_params.ffog_vlm_indirection_dims_brick_size.xyz, uvec3(0u))) ||
			ffog_vlm_params.ffog_vlm_indirection_dims_brick_size.w == 0u ||
			any(equal(ffog_vlm_params.ffog_vlm_atlas_dims_source_flags.xyz, uvec3(0u))) ||
			any(lessThanEqual(ffog_vlm_params.ffog_vlm_bounds_size.xyz, vec3(0.0))) ||
			!ffog_vlm_is_finite_vec3(p_world_position) ||
			!ffog_vlm_is_finite_vec3(p_world_camera_vector) ||
			dot(p_world_camera_vector, p_world_camera_vector) <= 1e-12) {
		return invalid_sample;
	}
	vec3 capture_position = (ffog_vlm_params.ffog_vlm_world_to_capture *
		vec4(p_world_position, 1.0)).xyz;
	if (!ffog_vlm_is_finite_vec3(capture_position)) {
		return invalid_sample;
	}
	vec3 indirection_uv = clamp((capture_position - ffog_vlm_params.ffog_vlm_bounds_min.xyz) /
		ffog_vlm_params.ffog_vlm_bounds_size.xyz, vec3(0.0), vec3(0.99));
	vec3 indirection_coord = indirection_uv * vec3(ffog_vlm_params.ffog_vlm_indirection_dims_brick_size.xyz);
	ivec3 indirection_cell = clamp(ivec3(floor(indirection_coord)), ivec3(0),
		ivec3(ffog_vlm_params.ffog_vlm_indirection_dims_brick_size.xyz) - ivec3(1));
	uvec4 brick = texelFetch(ffog_vlm_indirection, indirection_cell, 0);
	uint covered_size = brick.w;
	if (covered_size == 0u) {
		return invalid_sample;
	}
	float covered = float(covered_size);
	vec3 local_fraction = fract(indirection_coord / covered);
	float brick_size = float(ffog_vlm_params.ffog_vlm_indirection_dims_brick_size.w);
	vec3 atlas_dimensions = vec3(ffog_vlm_params.ffog_vlm_atlas_dims_source_flags.xyz);
	vec3 atlas_uv = (vec3(brick.xyz) * (brick_size + 1.0) +
		local_fraction * brick_size + vec3(0.5)) / atlas_dimensions;
	vec3 ambient = textureLod(ffog_vlm_ambient, atlas_uv, 0.0).rgb;
	vec4 red_l1 = (textureLod(ffog_vlm_sh0, atlas_uv, 0.0) * 2.0 - 1.0) * ambient.r * FFOG_VLM_SH2_L1_SCALE;
	vec4 green_l1 = (textureLod(ffog_vlm_sh2, atlas_uv, 0.0) * 2.0 - 1.0) * ambient.g * FFOG_VLM_SH2_L1_SCALE;
	vec4 blue_l1 = (textureLod(ffog_vlm_sh4, atlas_uv, 0.0) * 2.0 - 1.0) * ambient.b * FFOG_VLM_SH2_L1_SCALE;
	vec3 capture_camera_vector = normalize((ffog_vlm_params.ffog_vlm_world_direction_to_capture *
		vec4(normalize(p_world_camera_vector), 0.0)).xyz);
	float g = clamp(p_g, -0.999, 0.999);
	vec4 rotated_hg = vec4(1.0, capture_camera_vector.y, capture_camera_vector.z,
		capture_camera_vector.x) * vec4(1.0, g, g, g);
	vec3 irradiance_over_pi = max(vec3(
		dot(vec4(ambient.r, red_l1.xyz), rotated_hg),
		dot(vec4(ambient.g, green_l1.xyz), rotated_hg),
		dot(vec4(ambient.b, blue_l1.xyz), rotated_hg)), vec3(0.0)) / FFOG_VLM_PI;
	float sky_visibility = 1.0;
	if ((flags & FFOG_VLM_FLAG_HAS_SKY_BENT_NORMAL) != 0u) {
		vec3 sky_bent_normal = textureLod(ffog_vlm_sky_bent_normal, atlas_uv, 0.0).rgb * 2.0 - 1.0;
		sky_visibility = length(sky_bent_normal);
	}
	float directional_shadow = 1.0;
	if ((flags & (FFOG_VLM_FLAG_HAS_DIRECTIONAL_SHADOW | FFOG_VLM_FLAG_STATIC_LIGHT_KEY_MATCH)) ==
			(FFOG_VLM_FLAG_HAS_DIRECTIONAL_SHADOW | FFOG_VLM_FLAG_STATIC_LIGHT_KEY_MATCH)) {
		directional_shadow = textureLod(ffog_vlm_directional_shadow, atlas_uv, 0.0).r;
	}
	if (!ffog_vlm_is_finite_vec3(irradiance_over_pi) || !ffog_vlm_is_finite(sky_visibility) ||
			!ffog_vlm_is_finite(directional_shadow)) {
		return invalid_sample;
	}
	return FFogVolumetricLightmapSample(true, irradiance_over_pi, sky_visibility,
		directional_shadow, ffog_vlm_params.ffog_vlm_baked_metadata.x, flags);
}

bool ffog_vlm_includes_environment_radiance(FFogVolumetricLightmapSample p_sample) {
	return p_sample.valid && (p_sample.source_flags & FFOG_VLM_FLAG_INCLUDES_ENVIRONMENT_RADIANCE) != 0u;
}

bool ffog_vlm_contains_static_direct_directional_lighting(FFogVolumetricLightmapSample p_sample) {
	return p_sample.valid &&
		(p_sample.source_flags & (FFOG_VLM_FLAG_CONTAINS_STATIC_DIRECT_DIRECTIONAL_LIGHTING |
		FFOG_VLM_FLAG_STATIC_LIGHT_KEY_MATCH)) ==
		(FFOG_VLM_FLAG_CONTAINS_STATIC_DIRECT_DIRECTIONAL_LIGHTING |
		FFOG_VLM_FLAG_STATIC_LIGHT_KEY_MATCH);
}

#endif // FENG_FOG_VOLUMETRIC_LIGHTMAP_SAMPLING_GLSLINC
