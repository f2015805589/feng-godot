#!/usr/bin/env python
from glob import glob
from pathlib import Path
import os

# Reuse the repository's existing godot-cpp checkout, but write this addon's
# extension binary only to feng-lightmap-mc/bin.
NATIVE_ROOT = Path(os.getcwd()).resolve()
GODOT_CPP = NATIVE_ROOT.parent.parent / "feng-idweight-terrain" / "native" / "godot-cpp"
env = SConscript(str(GODOT_CPP / "SConstruct")).Clone()
# Only this worker-based extension needs C++ stack unwinding for an OS thread
# allocation failure. Keep godot-cpp's own build configuration unchanged.
if env["platform"] == "windows" and not env.get("use_mingw", False):
    env.Append(CXXFLAGS=["/EHsc"])
else:
    env.Append(CXXFLAGS=["-fexceptions"])
env.Append(CPPPATH=["src/", str(GODOT_CPP / "gdextension")])
sources = Glob("src/*.cpp")

(extension_path,) = glob("../*.gdextension")
addon_path = Path(extension_path).parent
project_name = Path(extension_path).stem
debug_or_release = "release" if env["target"] == "template_release" else "debug"

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "{0}/bin/lib{1}.{2}.{3}.framework/{1}.{2}.{3}".format(
            addon_path, project_name, env["platform"], debug_or_release
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "{}/bin/lib{}.{}.{}.{}{}".format(
            addon_path,
            project_name,
            env["platform"],
            debug_or_release,
            env["arch"],
            env["SHLIBSUFFIX"],
        ),
        source=sources,
    )

Default(library)
