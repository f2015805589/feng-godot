	} cloud_atmosphere_visibility
#define FENG_CLOUD_DECLARE_SHADOW_OUTPUT \
	layout(rgba16f, set = 1, binding = 3) uniform image2D cloud_out_shadow
// Cloud-shadow compute only: exactly 16 bytes. x selects sun slot 0/1; yzw are reserved.
#define FENG_CLOUD_DECLARE_SHADOW_DISPATCH \
	layout(push_constant, std430) uniform FengCloudShadowDispatch { uvec4 dispatch_controls; } cloud_shadow_dispatch
#ifndef FENG_CLOUD_SCENE_RGBA32
#define FENG_CLOUD_SCENE_RGBA32 0
#endif
#if FENG_CLOUD_SCENE_RGBA32
#define FENG_CLOUD_DECLARE_SCENE_OUTPUT \
	layout(rgba32f, set = 1, binding = 4) uniform image2D cloud_out_scene
#else
