#if FENG_CLOUD_VRT_SECONDARY
#define FENG_CLOUD_DECLARE_SECONDARY_TRACE_INPUTS \
	layout(set = 0, binding = 35) uniform sampler2DArray cloud_current_secondary_radiance; \
	layout(set = 0, binding = 36) uniform sampler2DArray cloud_current_secondary_transmittance
#define FENG_CLOUD_DECLARE_SECONDARY_HISTORY_INPUTS \
	layout(set = 0, binding = 37) uniform sampler2DArray cloud_previous_secondary_radiance; \
	layout(set = 0, binding = 38) uniform sampler2DArray cloud_previous_secondary_transmittance
#define FENG_CLOUD_DECLARE_SECONDARY_OUTPUTS \
	layout(rgba16f, set = 1, binding = 9) uniform image2DArray cloud_out_secondary_radiance; \
	layout(rgba16f, set = 1, binding = 10) uniform image2DArray cloud_out_secondary_transmittance
#else
#define FENG_CLOUD_DECLARE_SECONDARY_TRACE_INPUTS
