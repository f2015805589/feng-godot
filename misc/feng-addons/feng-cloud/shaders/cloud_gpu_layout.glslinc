#ifndef FENG_CLOUD_SKY_OCTMAP_ARRAY
#define FENG_CLOUD_SKY_OCTMAP_ARRAY 1
#endif

#ifndef FENG_CLOUD_UE58_LAYOUT_INPUTS
#define FENG_CLOUD_UE58_LAYOUT_INPUTS 0
#endif

#ifndef FENG_CLOUD_VRT_SECONDARY
#define FENG_CLOUD_VRT_SECONDARY 0
#endif

#if FENG_CLOUD_UE58_LAYOUT_INPUTS
// The injected material kernel is included through feng_cloud_common below,
// so all optional material resources must be declared first.
layout(set = 0, binding = 29) uniform sampler2D cloud_layout_pattern_texture;
layout(set = 0, binding = 30) uniform sampler2D cloud_layout_cloud_mask_texture;
layout(set = 0, binding = 31) uniform sampler2D cloud_layout_height_profile_texture;
layout(set = 0, binding = 32, std140) uniform FengCloudUE58TimeBlock { vec4 time_seconds; } cloud_ue58_time_block;
#define FENG_CLOUD_UE58_TIME_SECONDS (cloud_ue58_time_block.time_seconds.x)
#define FENG_CLOUD_UE58_CAMERA_WORLD_M (cloud_ue58_time_block.time_seconds.yzw)
#else
#define FENG_CLOUD_UE58_TIME_SECONDS 0.0
#define FENG_CLOUD_UE58_CAMERA_WORLD_M vec3(0.0)
#endif

#include "feng_cloud_common.glslinc"

const uint FENG_CLOUD_FRAME_CAPTURE = 1u << 0;
const uint FENG_CLOUD_FRAME_HISTORY_VALID = 1u << 1;
const uint FENG_CLOUD_FRAME_CAMERA_CUT = 1u << 2;
const uint FENG_CLOUD_FRAME_ORTHOGRAPHIC = 1u << 3;
const uint FENG_CLOUD_FRAME_ALPHA_HOLDOUT_SUPPORTED = 1u << 4;

struct FengCloudShellParameters {
	vec3 planet_center_km;
	float planet_radius_km;
	float layer_bottom_km;
	float layer_height_km;
	float trace_start_max_km;
	float trace_start_from_camera_km;
	float trace_max_km;
	int trace_max_mode;
	float shadow_distance_km;
	float stop_transmittance;
	float view_sample_scale;
	float reflection_view_sample_scale;
	float shadow_view_sample_scale;
	float reflection_shadow_sample_scale;
	float rayleigh_ap_start_m;
	float rayleigh_ap_fade_m;
	float mie_ap_start_m;
	float mie_ap_fade_m;
	float per_sample_atmosphere;
	float render_main;
	float visible_in_capture;
	float holdout;
	float bottom_sky_ao;
};

struct FengCloudFrameBlockData {
	mat4 inverse_view_projection;
	mat4 previous_view_projection;
	mat4 world_to_view;
	vec4 camera_world_position_m;
	vec4 previous_camera_world_position_m;
	vec4 viewport_size_xy_inv_xy;
	vec4 trace_phase_xy_trace_size_xy;
	vec4 radiance_scales_current_previous_norm_P;
	vec4 wind_delta_km_dt_time;
	uvec4 view_index_frame_index_flags_vrt_mode;
};

struct FengCloudLightingBlockData {
	mat4 sky_inverse_rotation;
	vec4 sun0_direction_enabled;
	vec4 sun0_top_irradiance_cast;
	vec4 sun0_ground_illuminance_shadow_index;
	vec4 sun1_direction_enabled;
	vec4 sun1_top_irradiance_cast;
	vec4 sun1_ground_illuminance_shadow_index;
	vec4 sky_octmap_parameters;
	vec4 sky_energy_captured_scale_max_mip_valid;
};

struct FengCloudProjectionControlData {
	mat4 world_to_cloud_shadow_clip[2];
	mat4 cloud_shadow_clip_to_world[2];
	mat4 world_to_cloud_ao_clip;
	mat4 cloud_ao_clip_to_world;
	// x/y are the per-sun far distances in km; z/w are the matching map resolutions.
	vec4 shadow_far_depth_km_sun0_sun1_resolution0_resolution1;
	vec4 shadow_strength0_strength1_biasKm0_biasKm1;
	vec4 surface_strength0_strength1_atmosphere_strength0_strength1;
	vec4 shadow_enabled0_enabled1_aoEnabled_reserved;
	vec4 shadow_sample_counts0_1_selfShadowUse0_1;
	vec4 shadow_map_size0_xy_inv_xy;
	vec4 shadow_map_size1_xy_inv_xy;
	vec4 ao_far_depth_km_strength_aperture_samples;
	vec4 ao_map_size_xy_inv_xy;
	vec4 ao_trace_direction_xyz_extent_km;
	vec4 projection_anchor_world_m_xyz_snap_km;
};

struct FengCloudNativeShadowData {
	mat4 atlas_transform[4];
	vec4 cascade_splits;
	vec4 shadow_bias;
	vec4 opacity_fade_start_end_valid;
};

#define FENG_CLOUD_DECLARE_FRAME \
	layout(set = 0, binding = 0, std140) uniform FengCloudFrameBlock { \
		mat4 inverse_view_projection; \
		mat4 previous_view_projection; \
		mat4 world_to_view; \
		vec4 camera_world_position_m; \
		vec4 previous_camera_world_position_m; \
		vec4 viewport_size_xy_inv_xy; \
		vec4 trace_phase_xy_trace_size_xy; \
		vec4 radiance_scales_current_previous_norm_P; \
		vec4 wind_delta_km_dt_time; \
		uvec4 view_index_frame_index_flags_vrt_mode; \
	} cloud_frame

#define FENG_CLOUD_DECLARE_MATERIAL \
	layout(set = 0, binding = 1, std140) uniform FengCloudMaterialBlock { vec4 lane[19]; } cloud_material_block

#define FENG_CLOUD_DECLARE_LIGHTING \
	layout(set = 0, binding = 2, std140) uniform FengCloudLightingBlock { \
		mat4 sky_inverse_rotation; \
		vec4 sun0_direction_enabled; vec4 sun0_top_irradiance_cast; vec4 sun0_ground_illuminance_shadow_index; \
		vec4 sun1_direction_enabled; vec4 sun1_top_irradiance_cast; vec4 sun1_ground_illuminance_shadow_index; \
		vec4 sky_octmap_parameters; vec4 sky_energy_captured_scale_max_mip_valid; \
	} cloud_lighting

#define FENG_CLOUD_DECLARE_ATMOSPHERE \
	layout(set = 0, binding = 3, std140) uniform FengCloudAtmosphereBlock { vec4 lane[16]; } cloud_atmosphere_block

#define FENG_CLOUD_DECLARE_HEIGHT_FOG \
	layout(set = 0, binding = 4, std140) uniform FengCloudHeightFogBlock { vec4 lane[7]; } cloud_height_fog_block

#define FENG_CLOUD_DECLARE_SHAPE_TEXTURE \
	layout(set = 0, binding = 5) uniform sampler3D cloud_shape_density_texture
#define FENG_CLOUD_DECLARE_DETAIL_TEXTURE \
	layout(set = 0, binding = 6) uniform sampler3D cloud_detail_density_texture
#define FENG_CLOUD_DECLARE_WEATHER_TEXTURE \
	layout(set = 0, binding = 7) uniform sampler2D cloud_weather_texture
#define FENG_CLOUD_DECLARE_CURL_TEXTURE \
	layout(set = 0, binding = 8) uniform sampler3D cloud_curl_texture
#define FENG_CLOUD_DECLARE_UE58_LAYOUT_TEXTURES
#define FENG_CLOUD_DECLARE_UE58_TIME
#define FENG_CLOUD_DECLARE_ATMOSPHERE_TEXTURES \
	layout(set = 0, binding = 9) uniform sampler2D cloud_atmosphere_optical_texture; \
	layout(set = 0, binding = 10) uniform sampler2D cloud_atmosphere_multiple_texture
#if FENG_CLOUD_SKY_OCTMAP_ARRAY
#define FENG_CLOUD_DECLARE_SKY_RADIANCE layout(set = 0, binding = 11) uniform sampler2DArray cloud_sky_radiance
#else
#define FENG_CLOUD_DECLARE_SKY_RADIANCE layout(set = 0, binding = 11) uniform sampler2D cloud_sky_radiance
#endif
