#define FENG_CLOUD_DECLARE_CURRENT_RESULTS \
	layout(set = 0, binding = 18) uniform sampler2DArray cloud_current_radiance; \
	layout(set = 0, binding = 19) uniform sampler2DArray cloud_current_transmittance; \
