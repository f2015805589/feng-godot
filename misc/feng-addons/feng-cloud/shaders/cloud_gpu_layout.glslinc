#define FENG_CLOUD_DECLARE_SCENE_DEPTH \
	layout(set = 0, binding = 13) uniform sampler2D cloud_scene_depth
#define FENG_CLOUD_DECLARE_MOTION \
	layout(set = 0, binding = 14) uniform sampler2D cloud_motion_vectors
#define FENG_CLOUD_DECLARE_HISTORY \
	layout(set = 0, binding = 15) uniform sampler2DArray cloud_previous_radiance; \
	layout(set = 0, binding = 16) uniform sampler2DArray cloud_previous_transmittance; \
