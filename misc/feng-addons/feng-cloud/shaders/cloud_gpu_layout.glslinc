	layout(rgba16f, set = 1, binding = 4) uniform image2D cloud_out_scene
#endif
#define FENG_CLOUD_DECLARE_AO_OUTPUT \
	layout(r16f, set = 1, binding = 5) uniform image2D cloud_out_ao
#define FENG_CLOUD_DECLARE_SKY_AMBIENT_INPUT \
	layout(set = 0, binding = 27) uniform sampler2D cloud_sky_ambient
#define FENG_CLOUD_DECLARE_SKY_AMBIENT_OUTPUT \
	layout(rgba32f, set = 1, binding = 6) uniform image2D cloud_out_sky_ambient
#define FENG_CLOUD_DECLARE_AO_STATS_OUTPUT \
	layout(rgba16f, set = 1, binding = 7) uniform image2D cloud_out_ao_stats
#define FENG_CLOUD_DECLARE_SHADOW_FILTER_OUTPUT \
	layout(rgba16f, set = 1, binding = 8) uniform image2D cloud_out_shadow_filter

FengCloudMaterialParameters feng_cloud_material_from_lanes(vec4 lane[19]) {
	FengCloudMaterialParameters p = feng_cloud_material_defaults();
	p.shape_uv_scale = lane[3].xyz;
	p.density_scale = lane[3].w;
	p.detail_uv_scale = lane[4].xyz;
	p.detail_strength = lane[4].w;
	p.weather_uv_scale = lane[5].xy;
	p.weather_strength = lane[5].z;
	p.coverage = lane[5].w;
	p.wind_offset_km = lane[6].xyz;
	p.conservative_density = lane[6].w;
	p.extinction_per_km = lane[7].xyz;
	p.ao_strength = lane[7].w;
	p.albedo = lane[8].rgb;
	p.ao_override = lane[8].w > 0.5;
	p.emission_per_km = lane[9].rgb;
	p.use_detail = lane[9].w > 0.5 && lane[17].y > 0.5;
	p.curl_uv_scale = lane[18].xyz;
	p.curl_strength = lane[18].w;
	p.use_weather = lane[17].z > 0.5;
	p.use_curl = lane[17].w > 0.5;
	p.shape_texture_valid = lane[17].x > 0.5;
	return p;
}

FengCloudAdvancedMaterial feng_cloud_advanced_from_lanes(vec4 lane[19]) {
	FengCloudAdvancedMaterial p = feng_cloud_advanced_defaults();
	p.phase_g = lane[10].x;
	p.phase_g2 = lane[10].y;
	p.phase_blend = lane[10].z;
	p.phase_per_sample = lane[10].w > 0.5;
	p.multiscatter_octaves = clamp(int(round(lane[11].x)), 0, 2);
	p.multiscatter_contribution = lane[11].y;
	p.multiscatter_occlusion = lane[11].z;
	p.multiscatter_eccentricity = lane[11].w;
	p.ground_contribution = lane[12].x > 0.5;
	p.grayscale_extinction = lane[12].y > 0.5;
	p.raymarch_shadow = lane[12].z > 0.5;
	p.clamp_multiscatter_contribution = lane[12].w > 0.5;
	return p;
}

FengCloudShellParameters feng_cloud_shell_from_lanes(vec4 lane[19]) {
	FengCloudShellParameters p;
	p.planet_center_km = lane[0].xyz * FENG_CLOUD_M_TO_KM;
	p.planet_radius_km = lane[0].w * FENG_CLOUD_M_TO_KM;
	p.layer_bottom_km = lane[1].x * FENG_CLOUD_M_TO_KM;
	p.layer_height_km = lane[1].y * FENG_CLOUD_M_TO_KM;
	p.trace_start_max_km = lane[1].z * FENG_CLOUD_M_TO_KM;
	p.trace_start_from_camera_km = lane[1].w * FENG_CLOUD_M_TO_KM;
	p.trace_max_km = lane[2].x * FENG_CLOUD_M_TO_KM;
	p.trace_max_mode = clamp(int(round(lane[2].y)), 0, 1);
	p.shadow_distance_km = lane[2].z * FENG_CLOUD_M_TO_KM;
	p.stop_transmittance = clamp(lane[2].w, 0.0, 1.0);
	p.view_sample_scale = lane[14].x;
	p.reflection_view_sample_scale = lane[14].y;
	p.shadow_view_sample_scale = lane[14].z;
	p.reflection_shadow_sample_scale = lane[14].w;
	p.rayleigh_ap_start_m = lane[15].x;
	p.rayleigh_ap_fade_m = lane[15].y;
	p.mie_ap_start_m = lane[15].z;
	p.mie_ap_fade_m = lane[15].w;
	p.per_sample_atmosphere = lane[16].x;
	p.render_main = lane[16].y;
	p.visible_in_capture = lane[16].z;
	p.holdout = lane[16].w;
	p.bottom_sky_ao = lane[13].w;
	return p;
}

FengCloudSun feng_cloud_sun_from_lighting(vec4 direction_enabled, vec4 top_irradiance_cast, vec4 ground_illuminance_shadow_index) {
	FengCloudSun sun = feng_cloud_sun_defaults();
	sun.direction_to_light = feng_cloud_safe_normalize3(direction_enabled.xyz, vec3(0.0, 1.0, 0.0));
	sun.enabled = direction_enabled.w > 0.5;
	sun.top_irradiance = feng_cloud_positive_finite3(top_irradiance_cast.rgb);
	sun.ground_irradiance = feng_cloud_positive_finite3(ground_illuminance_shadow_index.rgb);
	return sun;
}

float feng_cloud_storage_safe_half(float value) {
	return clamp(feng_cloud_finite_or_zero(value), -65504.0, 65504.0);
}

vec3 feng_cloud_storage_safe_half3(vec3 value) {
	return clamp(feng_cloud_finite_or_zero3(value), vec3(-65504.0), vec3(65504.0));
}

#endif // FENG_CLOUD_GPU_LAYOUT_GLSLINC
