#define FENG_CLOUD_DECLARE_SCENE_COLOR \
	layout(set = 0, binding = 21) uniform sampler2DArray cloud_scene_color
#define FENG_CLOUD_DECLARE_NATIVE_SHADOW_DATA \
	layout(set = 0, binding = 22, std140) uniform FengCloudNativeShadowBlock { \
		mat4 atlas_transform[4]; vec4 cascade_splits; vec4 shadow_bias; vec4 opacity_fade_start_end_valid; \
		mat4 atlas_transform1[4]; vec4 cascade_splits1; vec4 shadow_bias1; vec4 opacity_fade_start_end_valid1; \
		vec4 atlas_size_xy_inv_xy; \
	} cloud_native_shadow_data
#define FENG_CLOUD_DECLARE_PROJECTION_CONTROL \
	layout(set = 0, binding = 23, std140) uniform FengCloudProjectionControlBlock { \
		mat4 world_to_cloud_shadow_clip[2]; mat4 cloud_shadow_clip_to_world[2]; \
		mat4 world_to_cloud_ao_clip; mat4 cloud_ao_clip_to_world; \
		vec4 shadow_far_depth_km_sun0_sun1_resolution0_resolution1; \
		vec4 shadow_strength0_strength1_biasKm0_biasKm1; \
		vec4 surface_strength0_strength1_atmosphere_strength0_strength1; \
		vec4 shadow_enabled0_enabled1_aoEnabled_reserved; \
		vec4 shadow_sample_counts0_1_selfShadowUse0_1; \
		vec4 shadow_map_size0_xy_inv_xy; vec4 shadow_map_size1_xy_inv_xy; \
		vec4 ao_far_depth_km_strength_aperture_samples; vec4 ao_map_size_xy_inv_xy; \
		vec4 ao_trace_direction_xyz_extent_km; vec4 projection_anchor_world_m_xyz_snap_km; \
	} cloud_projection_control
#define FENG_CLOUD_DECLARE_CLOUD_SHADOW_TEXTURES \
	layout(set = 0, binding = 24) uniform sampler2D cloud_shadow_map0; \
