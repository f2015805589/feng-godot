#ifndef FENG_CLOUD_PROJECTED_SHELL_GLSLINC
#define FENG_CLOUD_PROJECTED_SHELL_GLSLINC

#include "feng_cloud_shell.glslinc"

struct FengCloudProjectedShellSpan {
	float start_km;
	float end_km;
	bool valid;
};

// Restrict projected shadow/AO rays to the first cloud-shell segment before
// the planet blocks the ray. The caller distributes its fixed sample budget
// uniformly over this interval instead of wasting samples in empty space.
FengCloudProjectedShellSpan feng_cloud_projected_shell_span(
		vec3 ray_origin_km,
		vec3 ray_direction,
		vec3 shell_center_km,
		float bottom_radius_km,
		float top_radius_km,
		float max_distance_km) {
	FengCloudProjectedShellSpan span;
	span.start_km = 0.0;
	span.end_km = 0.0;
	span.valid = false;

	vec2 outer_roots;
	if (!feng_cloud_ray_sphere_roots(ray_origin_km, ray_direction, shell_center_km, top_radius_km, outer_roots)) {
		return span;
	}
	float max_distance = feng_cloud_positive_finite(max_distance_km);
	span.start_km = max(outer_roots.x, 0.0);
	span.end_km = min(outer_roots.y, max_distance);
	if (!(span.end_km > span.start_km)) {
		return span;
	}

	vec2 inner_roots;
	if (feng_cloud_ray_sphere_roots(ray_origin_km, ray_direction, shell_center_km, bottom_radius_km, inner_roots)) {
		float inner_enter = max(inner_roots.x, 0.0);
		float inner_exit = inner_roots.y;
		// If the near plane is already inside the planet, no cloud segment is
		// visible along this groundward projection ray.
		if (inner_roots.x < 0.0 && inner_exit > 0.0) {
			return span;
		}
		if (inner_enter > span.start_km) {
			span.end_km = min(span.end_km, inner_enter);
		}
	}
	span.valid = span.end_km > span.start_km;
	return span;
}

#endif // FENG_CLOUD_PROJECTED_SHELL_GLSLINC
