#[compute]
#version 450

#include "cloud_gpu_layout.glslinc"
#include "feng_cloud_projected_shell.glslinc"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

FENG_CLOUD_DECLARE_MATERIAL;
FENG_CLOUD_DECLARE_PROJECTION_CONTROL;
FENG_CLOUD_DECLARE_SHAPE_TEXTURE;
FENG_CLOUD_DECLARE_DETAIL_TEXTURE;
FENG_CLOUD_DECLARE_WEATHER_TEXTURE;
FENG_CLOUD_DECLARE_CURL_TEXTURE;
FENG_CLOUD_DECLARE_AO_STATS_OUTPUT;

const int FENG_CLOUD_AO_MAX_TRACE_SAMPLES = 256;

vec3 feng_cloud_ao_unproject(vec3 clip_position) {
	vec4 world_h = cloud_projection_control.cloud_ao_clip_to_world * vec4(clip_position, 1.0);
	float safe_w = abs(world_h.w) > 1e-8 ? world_h.w : (world_h.w < 0.0 ? -1e-8 : 1e-8);
	return feng_cloud_finite_or_zero3(world_h.xyz / safe_w);
}

float feng_cloud_ao_grey_extinction(vec3 extinction_per_km, bool use_red_channel) {
	vec3 sigma = feng_cloud_positive_finite3(extinction_per_km);
	return use_red_channel ? sigma.r : dot(sigma, vec3(1.0 / 3.0));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 target_size = imageSize(cloud_out_ao_stats);
	if (any(greaterThanEqual(pixel, target_size))) {
		return;
	}
	vec4 ao_far_strength_aperture_samples = cloud_projection_control.ao_far_depth_km_strength_aperture_samples;
	float far_depth_km = feng_cloud_positive_finite(ao_far_strength_aperture_samples.x);
	float ao_strength = clamp(feng_cloud_finite_or_zero(ao_far_strength_aperture_samples.y), 0.0, 1.0);
	int sample_count = clamp(int(round(feng_cloud_finite_or_zero(ao_far_strength_aperture_samples.w))), 0, FENG_CLOUD_AO_MAX_TRACE_SAMPLES);
	bool ao_enabled = cloud_projection_control.shadow_enabled0_enabled1_aoEnabled_reserved.z > 0.5;
	if (!ao_enabled || ao_strength <= 0.0 || !(far_depth_km > 0.0) || sample_count <= 0) {
		imageStore(cloud_out_ao_stats, pixel, vec4(0.0));
		return;
	}
	vec4 material_lanes[19];
	for (int i = 0; i < 19; ++i) {
		material_lanes[i] = cloud_material_block.lane[i];
	}
	FengCloudMaterialParameters material_parameters = feng_cloud_material_from_lanes(material_lanes);
	FengCloudAdvancedMaterial advanced_parameters = feng_cloud_advanced_from_lanes(material_lanes);
	FengCloudShellParameters shell = feng_cloud_shell_from_lanes(material_lanes);
	vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(target_size);
	vec2 clip_xy = uv * 2.0 - 1.0;
	vec3 ray_origin_world_m = feng_cloud_ao_unproject(vec3(clip_xy, 1.0));
	vec3 ray_far_world_m = feng_cloud_ao_unproject(vec3(clip_xy, 0.0));
	vec2 clip_step = 2.0 / vec2(max(target_size, ivec2(1)));
	vec3 ray_origin_x_m = feng_cloud_ao_unproject(vec3(clip_xy + vec2(clip_step.x, 0.0), 1.0));
	vec3 ray_origin_y_m = feng_cloud_ao_unproject(vec3(clip_xy + vec2(0.0, clip_step.y), 1.0));
	vec3 ray_origin_km = ray_origin_world_m * FENG_CLOUD_M_TO_KM;
	vec3 trace_direction = feng_cloud_safe_normalize3(
		cloud_projection_control.ao_trace_direction_xyz_extent_km.xyz, vec3(0.0, -1.0, 0.0));
	float matrix_depth_km = length((ray_far_world_m - ray_origin_world_m) * FENG_CLOUD_M_TO_KM);
	float trace_depth_km = min(far_depth_km, matrix_depth_km);
	if (!(trace_depth_km > 0.0) || isnan(trace_depth_km) || isinf(trace_depth_km)) {
		imageStore(cloud_out_ao_stats, pixel, vec4(0.0));
		return;
	}
	vec3 planet_center_km = shell.planet_center_km;
	float bottom_radius_km = shell.planet_radius_km + shell.layer_bottom_km;
	float top_radius_km = bottom_radius_km + shell.layer_height_km;
	FengCloudProjectedShellSpan span = feng_cloud_projected_shell_span(
		ray_origin_km, trace_direction, planet_center_km, bottom_radius_km, top_radius_km, trace_depth_km);
	if (!span.valid) {
		imageStore(cloud_out_ao_stats, pixel, vec4(0.0));
		return;
	}
	float step_length_km = (span.end_km - span.start_km) / float(sample_count);
	float total_tau = 0.0;
	float sum_sigma_per_m = 0.0;
	int occupied_sample_count = 0;
	float front_depth_km = trace_depth_km;
	bool has_cloud = false;
	for (int i = 0; i < FENG_CLOUD_AO_MAX_TRACE_SAMPLES; ++i) {
		if (i >= sample_count) {
			break;
		}
		float sample_distance_km = span.start_km + (float(i) + 0.5) * step_length_km;
		vec3 sample_position_km = ray_origin_km + trace_direction * sample_distance_km;
		float radius_km = length(sample_position_km - planet_center_km);
		if (radius_km < bottom_radius_km) {
			break;
		}
		if (radius_km > top_radius_km) {
			continue;
		}
		FengCloudSampleContext context = feng_cloud_sample_context(
			sample_position_km, planet_center_km, bottom_radius_km, shell.layer_height_km,
			sample_distance_km, sample_distance_km,
			(ray_origin_x_m - ray_origin_world_m) * FENG_CLOUD_M_TO_KM,
			(ray_origin_y_m - ray_origin_world_m) * FENG_CLOUD_M_TO_KM);
		FengCloudMaterialSample material_sample = feng_cloud_sample_material(
			cloud_shape_density_texture, cloud_detail_density_texture, cloud_weather_texture, cloud_curl_texture,
			context, material_parameters, 0.0);
		float sigma_per_km = feng_cloud_ao_grey_extinction(
			feng_cloud_extinction_for_sampling(material_sample, advanced_parameters.grayscale_extinction),
			advanced_parameters.grayscale_extinction);
		if (!(sigma_per_km > 0.0)) {
			continue;
		}
		if (!has_cloud) {
			front_depth_km = sample_distance_km;
			has_cloud = true;
		}
		float sigma_per_m = sigma_per_km * FENG_CLOUD_M_TO_KM;
		sum_sigma_per_m += sigma_per_m;
		total_tau += sigma_per_km * step_length_km;
		occupied_sample_count++;
	}
	if (!has_cloud || occupied_sample_count <= 0 || !(total_tau > 0.0) || isnan(total_tau) || isinf(total_tau)) {
		imageStore(cloud_out_ao_stats, pixel, vec4(0.0));
		return;
	}
	float mean_sigma_per_m = ao_strength * sum_sigma_per_m / float(occupied_sample_count);
	float maximum_optical_depth = ao_strength * total_tau;
	imageStore(cloud_out_ao_stats, pixel, vec4(
		feng_cloud_storage_safe_half(front_depth_km),
		feng_cloud_storage_safe_half(mean_sigma_per_m),
		feng_cloud_storage_safe_half(maximum_optical_depth),
		1.0));
}
