#ifndef FENG_CLOUD_UE58_DEFAULT_KERNEL_GLSLINC
#define FENG_CLOUD_UE58_DEFAULT_KERNEL_GLSLINC

// Active UE 5.8 Deferred path for m_SimpleVolumetricCloud_Inst.
// Coordinates are Godot world kilometers; the UE material graph uses cm and Z-up.
// The source graph's Layout_GlobalTexturePlacement CDO is zero and the instance
// has no override, so its placement is intentionally omitted here.
vec3 feng_cloud_ue58_godot_to_ue_km(vec3 godot_world_km) {
	return vec3(godot_world_km.x, -godot_world_km.z, godot_world_km.y);
}

FengCloudMaterialSample feng_cloud_custom_material_sample(
	sampler3D shape_density_texture,
	sampler3D detail_density_texture,
	sampler2D weather_texture,
	sampler3D curl_noise_texture,
	FengCloudSampleContext context,
	FengCloudMaterialParameters parameters,
	float lod) {
	FengCloudMaterialSample material_sample = feng_cloud_empty_material_sample();
	float normalized_altitude = feng_cloud_finite_or_zero(context.normalized_altitude_in_layer);
	if (normalized_altitude <= 0.0 || normalized_altitude >= 1.0 || !parameters.shape_texture_valid) {
		return material_sample;
	}

	// Layout_GlobalTexturePlacement is CDO-zero (RGBA); its XY is subtracted
	// after Rotator and added back on the AO-mask path. Rotator Time is its A,
	// also zero. TruncateLWC is an identity after conversion to this float-km input.
	// wind_offset_km is the add-on's world-space translation, not the graph's
	// animated Layout_WindControls term; it affects material coordinates only.
	vec3 godot_material_world_km = context.world_position_km
		+ feng_cloud_finite_or_zero3(parameters.wind_offset_km);
	vec3 ue_material_world_km = feng_cloud_ue58_godot_to_ue_km(godot_material_world_km);
	vec3 global_coordinate = ue_material_world_km / 256.0 + vec3(0.5, 0.5, 0.0);
	vec2 pattern_uv = global_coordinate.xy;

	// UE cloud view stages force mip 0 for TMVM_None samples (USE_FORCE_TEXTURE_MIP=1).
	// Keep that renderer contract in compute instead of selecting an implicit LOD.
	vec4 pattern_sample = textureLod(cloud_layout_pattern_texture, pattern_uv, 0.0);
	float conservative_pattern = max(pattern_sample.r, max(pattern_sample.g, pattern_sample.b));
	material_sample.conservative_density = conservative_pattern;
	if (!(conservative_pattern > 0.0)) {
		return material_sample;
	}

	// The source profile nodes use explicit mip 0. Their UV is (normalized
	// altitude, the corresponding R/G/B channel of the global pattern sample).
	float profile_r = textureLod(cloud_layout_height_profile_texture,
		vec2(normalized_altitude, pattern_sample.r), 0.0).r;
	float profile_g = textureLod(cloud_layout_height_profile_texture,
		vec2(normalized_altitude, pattern_sample.g), 0.0).g;
	float profile_b = textureLod(cloud_layout_height_profile_texture,
		vec2(normalized_altitude, pattern_sample.b), 0.0).b;
	float profile_max = max(profile_r, max(profile_g, profile_b));
	float conservative_blue = profile_max - 0.5;

	// TextureProperty(TextureSize).R is evaluated from the runtime Pattern
	// texture extent, not its source-asset extent. Time wraps at the serialized
	// UE Time period; Layout_WindControls.rgb * A is (.333333,.333333,.166667).
	float pattern_runtime_width = float(max(textureSize(cloud_layout_pattern_texture, 0).x, 1));
	float time_seconds = mod(max(feng_cloud_finite_or_zero(FENG_CLOUD_UE58_TIME_SECONDS), 0.0), 9999999.0);
	float wind_time = time_seconds / max(pattern_runtime_width * 256.0 * 1000.0, 1.0);
	vec3 layout_wind = vec3(1.0, 1.0, 0.5) * 0.33333298563957214;
	vec3 animated_layout_wind = layout_wind * wind_time;

	// Noise2_Coordinates drives the R-channel coordinate warp (LOD 0).
	// Noise_Strength.G=.08 and Noise_Bias.G=.8 are serialized parameter defaults.
	vec3 noise2_uv = global_coordinate * vec3(60.0, 60.0, 75.0)
		+ animated_layout_wind * -6.0;
	float warp_noise = textureLod(shape_density_texture, noise2_uv, 0.0).r;
	float coordinate_warp = (warp_noise - 0.8) * 0.08;
	float profile_height = 0.05 + 0.95 * normalized_altitude;
	vec3 profile_warp_shape = vec3(
		profile_height,
		profile_height,
		pow(2.0 * abs(profile_height - 0.5), 2.0));

	// Noise1_Coordinates drives the G-channel density term (LOD 0).
	vec3 noise1_uv = global_coordinate * vec3(4.167, 4.444, 9.091)
		+ animated_layout_wind * 7.0
		+ profile_warp_shape * coordinate_warp;
	float density_noise = textureLod(shape_density_texture, noise1_uv, 0.0).g;
	float conservative_alpha = 0.8 * (density_noise - 0.5 - 0.2);

	// Deferred SubsurfaceColor consumes R*(B+A), gated by the If node around
	// normalized altitude .5. The mask term is connected in UE, but evaluates to
	// zero for the serialized Layout_CloudTypeMask.rgb=(0,0,0) default.
	vec3 cloud_mask = textureLod(cloud_layout_cloud_mask_texture, pattern_uv, 0.0).rgb;
	float mask_contribution = dot(cloud_mask * vec3(1.0), vec3(0.0)) * 0.001;
	float altitude_gate = abs(normalized_altitude - 0.5) <= 0.48 ? 1.0 : 0.0;
	float camera_relative_cm = length((context.world_position_km
		- FENG_CLOUD_UE58_CAMERA_WORLD_M * FENG_CLOUD_M_TO_KM) * 100000.0);
	float distance_fade = clamp(camera_relative_cm * 1.99999995e-5, 0.0, 1.0);
	float extinction_per_meter = clamp(altitude_gate * 0.008 * distance_fade
		* (conservative_pattern * (conservative_blue + conservative_alpha) + mask_contribution), 0.0, 1.0);

	// UE's material output is used as a per-meter extinction coefficient. The
	// common transport API stores coefficients per kilometer, hence the x1000.
	material_sample.extinction_per_km = vec3(extinction_per_meter * FENG_CLOUD_KM_TO_M);
	material_sample.albedo = vec3(0.98);
	material_sample.emission_per_km = vec3(0.0);
	material_sample.density = extinction_per_meter;
	material_sample.ambient_occlusion = 0.5;
	return material_sample;
}

#endif // FENG_CLOUD_UE58_DEFAULT_KERNEL_GLSLINC
